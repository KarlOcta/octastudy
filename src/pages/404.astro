---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite existiert nicht (mehr)."
  noindex
>
  <div class="prose center">
    <p class="eyebrow">Fehler 404</p>
    <h1>Diese Seite gibt es nicht.</h1>
    <p class="lead">
      Vermutlich ein alter Link oder ein Tippfehler in der Adresse. Von hier aus
      kommst du weiter:
    </p>
    <div class="btn-row">
      <a class="btn" href="/">Zur Startseite</a>
      <a class="btn btn--ghost" href="/schemata/">Prüfungsschemata</a>
      <a class="btn btn--ghost" href="/tools/">Lerntools</a>
    </div>
  </div>
</BaseLayout>

<style>
  .center {
    text-align: center;
    padding-block: 3rem;
  }

  .center .btn-row {
    justify-content: center;
  }
</style>
