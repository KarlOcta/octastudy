---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OctaCtaBox from '../../../components/OctaCtaBox.astro';
import MockupSlideshow from '../../../components/MockupSlideshow.astro';
import { OCTA, APP_RATING, APP_REVIEWS, SITE } from '../../../site';

const HERO_SLIDES = [
  {
    src: '/img/mockups/app/en/andere-test.webp',
    alt: 'Octa flashcard with a "Test yourself" button — the student speaks the answer out loud',
    caption: 'Spoken answer',
    width: 792,
    height: 1599,
  },
  {
    src: '/img/mockups/app/en/andere-plan.webp',
    alt: 'Octa study plan with a learning path and progress toward the exam date',
    caption: 'Automatic study plan',
    width: 792,
    height: 1599,
  },
  {
    src: '/img/mockups/app/en/andere-karte.webp',
    alt: 'Octa flashcard generated from uploaded course material',
    caption: 'Automatic flashcards',
    width: 792,
    height: 1599,
  },
  {
    src: '/img/mockups/app/en/andere-tribes.webp',
    alt: 'Octa Tribes screen showing a weekly leaderboard of study groups',
    caption: 'Progress in Tribes',
    width: 792,
    height: 1599,
  },
];

const ICONS = {
  cards: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M7 4h11a2 2 0 0 1 2 2v9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M7 11h6M7 14h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  mic: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M5 11a7 7 0 0 0 14 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 18v3M9 21h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.3" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4.7" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>`,
  bulb: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18h6M10 21h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 3a6.3 6.3 0 0 0-3.7 11.4c.6.43 1 .9 1.1 1.7h5.2c.1-.8.5-1.27 1.1-1.7A6.3 6.3 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12a8 8 0 1 1 3.2 6.4L4 20l1.1-3.4A7.96 7.96 0 0 1 4 12Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 10.1c0-1.1.9-1.9 2-1.9s2 .78 2 1.75c0 1.45-1.8 1.45-1.8 3.05" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12.15" cy="15.9" r="0.9" fill="currentColor"/></svg>`,
  group: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.5" cy="8.5" r="2.7" stroke="currentColor" stroke-width="1.7"/><circle cx="16.2" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.7"/><path d="M3.4 19c.4-3 2.4-4.8 5.1-4.8s4.6 1.8 5 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M14.5 14.6c2.2.25 3.8 1.85 4.1 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
};

const FEATURES = [
  {
    title: 'Your material becomes flashcards',
    text: 'Upload lecture slides, a scanned handout, or just type in the topic. Octa reads it and builds flashcards from it — no typing out questions by hand.',
    icon: ICONS.cards,
    tint: 'purple',
  },
  {
    title: '"Test yourself" — out loud, not silently',
    text: "Every card has a Test Yourself button. You say your answer out loud instead of just recognizing it on the screen, and Octa gives you real spoken feedback on what you got right and what you missed.",
    icon: ICONS.mic,
    tint: 'pink',
  },
  {
    title: 'A study plan built around your target grade',
    text: "Upload your material and tell Octa the grade you're aiming for. It turns that into a study plan — a short, focused version if you just need to pass, a more intensive one if you're aiming higher — and times the reviews for exactly when you're about to forget, instead of one long cram session.",
    icon: ICONS.target,
    tint: 'mint',
  },
  {
    title: 'An AI tutor that explains the answer',
    text: "Got a flashcard wrong, or only half right? Octa's AI tutor doesn't just show you the correct answer — it walks through why it's correct, in as much depth as you need.",
    icon: ICONS.bulb,
    tint: 'yellow',
  },
  {
    title: 'Ask it anything about your material',
    text: "Beyond flashcards, Octa's AI tutor answers specific questions about whatever you've uploaded and works through problems with you step by step — like a tutor who has actually read your lecture notes.",
    icon: ICONS.chat,
    tint: 'purple',
  },
  {
    title: 'Tribes — visible progress, not solo intentions',
    text: 'Join a Tribe of students working toward the same kind of exam. Your study sessions show up there automatically, so skipping a day is something the group can actually see.',
    icon: ICONS.group,
    tint: 'pink',
  },
];

const FAQ = [
  {
    q: 'What devices does Octa run on?',
    a: 'Octa is currently available for iPhone and iPad only. An Android version is in the works — you can join the waitlist from the Study Type Quiz page.',
  },
  {
    q: 'Where do the flashcards come from?',
    a: "From your own material. Upload a PDF, slides, or a photo of your notes, or just type in a topic — Octa turns it into flashcards instead of handing you a generic deck that doesn't match your course.",
  },
  {
    q: 'Does it work for my subject?',
    a: "Octa is built to work with whatever you upload, so it isn't limited to one field. It's already used across subjects including law, business, medicine, computer science, and engineering.",
  },
  {
    q: 'How much does Octa cost?',
    a: 'Pricing is shown directly on the App Store listing before you download.',
  },
  {
    q: 'Is this different from just using Anki or Quizlet?',
    a: "Anki and Quizlet are built around cards you (or someone else) already wrote by hand. Octa builds the cards from your own material, adds spoken self-testing instead of just flipping a card, and times the reviews for you instead of leaving spacing up to a manual schedule.",
  },
  {
    q: 'What does the AI tutor actually do?',
    a: "Two things. On a flashcard, it explains the correct answer in depth when you got it wrong or only half right, instead of just showing you the answer text. Separately, you can ask it direct questions about your own uploaded material or work through a problem with it — it only knows what you've given it, not a generic answer pulled from anywhere else.",
  },
];

const storeLink = OCTA.appStoreUrlEn;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/en/app/#faq`,
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<BaseLayout
  title="Octa — The AI Study App for Flashcards & Spoken Self-Testing"
  description="Octa turns your own course material into flashcards, quizzes you out loud, and times the reviews before you forget. Free to try on iPhone and iPad."
  breadcrumbs={[{ label: 'The App', href: '/en/app/' }]}
  lang="en"
  wide
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <section class="hero">
    <div class="hero__inner wrap">
      <div class="hero__copy">
        <p class="eyebrow">For students who need to actually retain it</p>
        <h1>Material you <span class="hl">recall</span>, not just material you read</h1>
        <p class="lead">
          {OCTA.pitchEn} A study plan spaces the reviews out so it sticks —
          and a Tribe of other students makes sure you actually show up for
          it.
        </p>
        <div class="btn-row">
          <a class="btn" href={storeLink} rel="noopener">Get Octa on the App Store</a>
          <a class="btn btn--ghost" href="/en/tools/lerntyp-test/">Take the 1-minute quiz first</a>
        </div>
        <p class="hero__hint">iPhone and iPad · an Android version is in the works</p>
      </div>
      <div class="hero__mockup">
        <MockupSlideshow id="hero-slides" slides={HERO_SLIDES} intervalMs={4200} />
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">What Octa actually does</h2>
    <p class="section-intro">
      All of this working together — not a handful of separate apps bolted
      onto each other.
    </p>
    <div class="grid">
      {
        FEATURES.map((f) => (
          <div class="card">
            <div class={`card__icon card__icon--${f.tint}`} set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <div class="celebrate">
      <div class="celebrate__art">
        <img
          src="/img/app/celebrate-graduates.webp"
          alt="Two female students laughing together arm in arm, one wearing a graduation cap"
          width="900"
          height="1200"
          loading="lazy"
        />
      </div>
      <div class="celebrate__copy">
        <h2>The feeling when it finally clicks</h2>
        <p>
          That moment right after the exam when you realize: it actually
          stuck. That's exactly what Octa is built for — not one more tool,
          but getting you to that moment.
        </p>
        <div class="celebrate__stat">
          <span class="celebrate__rating">{APP_RATING.en.schnitt} ★</span>
          <span class="celebrate__rating-sub">
            {APP_RATING.en.anzahl} ratings on the App Store · as of {APP_RATING.en.stand}
          </span>
        </div>
        <blockquote class="celebrate__quote">
          "{APP_REVIEWS.en[0].t}"
          <cite>{APP_REVIEWS.en[0].w}, App Store review</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="octa-cta">
      <h2>Why we built it this way</h2>
      <p>
        Rereading and highlighting feel like progress, but a large review of
        study techniques found them among the least effective methods
        students use — while self-testing and spaced review, spread across
        several days, are consistently rated among the most effective. Octa
        is built around exactly those two techniques, instead of asking you
        to somehow do them by hand on top of everything else.
        <cite>Dunlosky et al., Psychological Science in the Public Interest,
        2013</cite>
      </p>
      <div class="btn-row">
        <a class="btn" href={storeLink} rel="noopener">Get Octa on the App Store</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">Frequently asked questions</h2>
    <div class="faq">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <OctaCtaBox
      id="closing-slides"
      title="Upload your first set of material"
      storeLink={storeLink}
      primaryLabel="Get Octa on the App Store"
      secondaryLabel="Take the Study Type Quiz"
      secondaryHref="/en/tools/lerntyp-test/"
      slides={HERO_SLIDES.slice(0, 3)}
      intervalMs={4200}
    >
      Ten minutes, one topic — enough to see whether spoken self-testing
      feels different from just rereading your notes.
    </OctaCtaBox>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
    padding-block: 0.5rem 2.5rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 2.5rem;
    align-items: center;
    max-width: min(var(--w-wide), 100%);
  }

  .hero__copy h1 {
    margin-bottom: 1.1rem;
  }

  .hero__mockup {
    /* Explicit width instead of only max-width: as a flex child with
       justify-self: center, the box otherwise shrinks to fit its
       content (the caption!) instead of holding a fixed width —
       shorter captions were shrinking the whole mockup and making
       the slideshow "jump" as it rotated. */
    width: min(260px, 100%);
    justify-self: center;
  }

  .hero__hint {
    margin: 0.9rem 0 0;
    font-size: 0.92rem;
    color: var(--text-subtle);
  }

  .section-intro {
    color: var(--text-muted);
    max-width: 40rem;
    margin-top: -0.35rem;
    margin-bottom: 1.4rem;
  }

  .celebrate {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
  }

  .celebrate__art {
    align-self: stretch;
    height: 100%;
  }

  .celebrate__art img {
    width: 100%;
    height: 100%;
    max-height: 22rem;
    object-fit: cover;
    display: block;
    border-radius: var(--radius);
  }

  .celebrate__copy h2 {
    margin-top: 0;
    margin-bottom: 0.6rem;
  }

  .celebrate__copy > p {
    color: var(--text-muted);
    margin-bottom: 1.2rem;
  }

  .celebrate__stat {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .celebrate__rating {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--brand-yellow);
  }

  .celebrate__rating-sub {
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .celebrate__quote {
    margin: 0;
    padding: 0.9rem 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .celebrate__quote cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  @media (max-width: 760px) {
    .celebrate {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .celebrate__art {
      width: 100%;
      height: auto;
    }

    .celebrate__art img {
      max-height: 18rem;
    }
  }

  .card__icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.9rem;
  }

  .card__icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .card__icon--purple {
    background: var(--accent-soft);
    color: var(--brand-purple);
  }

  .card__icon--pink {
    background: #fce8f1;
    color: var(--brand-pink);
  }

  .card__icon--mint {
    background: #e3f8f1;
    color: var(--brand-mint);
  }

  .card__icon--yellow {
    background: #fdf0d8;
    color: #b9790e;
  }

  @media (prefers-color-scheme: dark) {
    .card__icon--pink {
      background: #402336;
      color: #ff9dc7;
    }

    .card__icon--mint {
      background: #113831;
      color: #4bdcb0;
    }

    .card__icon--yellow {
      background: #3c2e10;
      color: #f0b94a;
    }
  }

  .octa-cta cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .faq {
    max-width: 50rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .faq__item {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.9rem 1.2rem;
    background: var(--bg-card);
  }

  .faq__item summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    float: right;
    color: var(--accent);
    font-weight: 800;
  }

  .faq__item[open] summary::after {
    content: '–';
  }

  .faq__item p {
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  section + section {
    margin-top: 2.5rem;
  }

  @media (max-width: 760px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__mockup {
      order: -1;
      width: min(200px, 100%);
    }
  }
</style>
