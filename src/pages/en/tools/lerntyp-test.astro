      was: "The switch is small and uncomfortable: close the page, answer the question without looking. What actually sticks only shows once the notes are gone — before that, you're only measuring familiarity.",
      warum: "In the large review by Dunlosky et al., highlighting and rereading landed in the lowest-effectiveness category. Self-testing and spaced study are the only two rated highly effective.",
      huerde: "You probably already know this. The reason you don't do it anyway is the effort: twenty flashcards per chapter is forty minutes of writing — and it happens before you study, right when motivation is already thin.",
    },
    ueberfordert: {
      titel: 'One task instead of twelve options',
      was: "You don't need a longer study session, you need a decision that's already been made. The material has to be cut into daily portions working backward from exam day, so when you sit down there's only one thing in front of you.",
      warum: 'People who decide in advance exactly when and how they’ll start follow through far more reliably than people who just intend to, in general. Making the decision ahead of time is the real lever — not willpower on the day itself.',
      huerde: "You could build a plan yourself. It holds up until the first day you miss — from there, the same decision overload is back, now with a backlog on top of it.",
    },
    einzel: {
      titel: 'A commitment someone else knows about',
      was: "You don't need a method, you need outside visibility. Something that turns a private intention into a commitment: visible progress in front of people working toward the same thing.",
      warum: "Studying together doesn't work because of the company — it works because of what it forces you to do: commit, explain, get noticed when you're absent. Without those three things, even a study group doesn't help much.",
      huerde: "A friend can barely fix this: they'll ask twice, then stop. What you need is something that works without reminders and without a status report.",
    },
    sprinter: {
      titel: 'The same material, spread across days',
      was: "Your pace isn't the problem — everything happening in a single block is. What you need is the same amount of work in short sessions, with reviews timed for exactly when you start to forget.",
      warum: "Spaced study is, alongside self-testing, the second highly effective method. The same amount of effort spread across several days stays available far longer than the same amount crammed into one sitting.",
      huerde: "You can't hit the right review timing by hand — too early does nothing, too late and it's gone. You'd have to track, for every single flashcard, exactly when it's due again.",
    },
  };

  /* Passender App-Screenshot je Profil. */
  const MOCKUP_CAP = {
    koenner: '"Test yourself" on the flashcard — you speak your answer out loud',
    sammler: 'Your collected material turns into an organized study plan',
    markierer: 'Flashcard built from your own material — recall instead of rereading',
    ueberfordert: "The study plan shows what's up today — one task",
    einzel: "Tribes — your progress is visible to the group",
    sprinter: 'The study plan spreads material across days, timed before you forget it',
  };

  /* ------------------------------------------------------------- Logik -- */

  const ORDER = ['koenner', 'sammler', 'markierer', 'ueberfordert', 'einzel', 'sprinter'];
  let step = 0;
  let picks = [];
  let locked = false;
  let fach = 'andere';
  let lerntyp = '';

  /* ------------------------------------------ anonyme Durchlaufstatistik --
     `laufId` entsteht bei jedem Seitenaufruf neu und wird nirgends abgelegt —
     kein Cookie, kein localStorage. Sie verbindet nur die Meldungen desselben
     Durchlaufs miteinander und ist beim naechsten Besuch eine andere. Damit
     entstehen anonyme Zahlen, keine personenbezogenen Daten. */
  const laufId = (() => {
    try {
      if (crypto && crypto.randomUUID) return crypto.randomUUID();
    } catch (e) {}
    return 'l-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
  })();
  let laufStart = 0;
  let zuletztGemeldet = -1;

  const geraeteArt = () => {
    const ua = navigator.userAgent;
    if (/iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1))
      return 'ios';
    if (/Android/.test(ua)) return 'android';
    if (/Mobi/.test(ua)) return 'andere';
    return 'desktop';
  };

  function melden(fertig) {
    if (!CONFIG.statistikEndpoint || !laufStart) return;
    const schritt = picks.filter((p) => p !== undefined && p !== null).length;
    if (!fertig && schritt === zuletztGemeldet) return;
    zuletztGemeldet = fertig ? 99 : schritt;
    const daten = JSON.stringify({
      lauf: laufId,
      fach: fach,
      schritt: schritt,
      abgeschlossen: fertig ? 1 : 0,
      lerntyp: fertig ? lerntyp : '',
      antworten: picks.map((p) => (p === undefined || p === null ? '' : p)).join(','),
      dauer_sek: Math.round((Date.now() - laufStart) / 1000),
      geraet: geraeteArt(),
    });
    try {
      /* sendBeacon blockiert nichts und kommt auch beim Verlassen der Seite
         noch an. Als Blob mit text/plain, damit kein Preflight noetig ist. */
      if (navigator.sendBeacon) {
        navigator.sendBeacon(CONFIG.statistikEndpoint, new Blob([daten], { type: 'text/plain' }));
        return;
      }
      fetch(CONFIG.statistikEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: daten,
        keepalive: true,
      }).catch(() => {});
    } catch (e) {}
  }

  window.addEventListener('pagehide', () => melden(false));
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') melden(false);
  });

  const isIOS =
    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const el = (id) => document.getElementById(id);
  const show = (id) =>
    document
      .querySelectorAll('.lt-screen')
      .forEach((s) => s.classList.toggle('on', s.id === id));

  function start() {
    el('faecher').innerHTML = FAECHER.map(
      ([k, label], i) =>
        `<button class="lt-fach" type="button" onclick="pickFach('${k}',this)">${label}</button>`
    ).join('');
    el('mascot-fach').innerHTML = octo('mascot', 'curious');
    show('s-fach');
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function pickFach(k, btn) {
    if (locked) return;
    locked = true;
    fach = k;
    if (btn) btn.classList.add('picked');
    if (window.plausible) window.plausible('fach_gewaehlt', { props: { fach: k } });
    laufStart = Date.now();
    melden(false);
    const go = () => {
      locked = false;
      show('s-quiz');
      render();
    };
    reduceMotion ? go() : setTimeout(go, 200);
  }

  /* Welcher App-Bildschirm passt zu welchem Profil. Sprinter zeigt denselben
     plan-Screen wie sammler/ueberfordert, weil sein Feature (Lernplan mit
     Wiederholungslogik) ebenfalls der Studienplan ist — kein eigener
     Dashboard/Streak-Screen mehr noetig. */
  const SCREEN = {
    koenner: 'test',
    sammler: 'plan',
    markierer: 'karte',
    ueberfordert: 'plan',
    einzel: 'tribes',
    sprinter: 'plan',
  };
  /* Fuer plan/karte/test existieren echte englische App-Store-Screenshots
     (zugeschnitten). tribes ist als eigenes Mockup nachgebaut (App Store hat
     dafuer keine Vorlage). Nur der fachunabhaengige home-Fallback hat noch
     keine englische Version. */
  const EN_SCREENS = new Set(['plan', 'karte', 'test', 'tribes']);
  const mockSrc = (key) => {
    const screen = SCREEN[key];
    if (screen && EN_SCREENS.has(screen)) return `/img/app/en/${fach}-${screen}.webp`;
    if (screen) return `/img/app/${fach}-${screen}.webp`;
    return '/img/app/home.webp';
  };

  function render() {
    const item = QUESTIONS[step];
    locked = false;
    el('q').textContent = item.q;
    el('count').textContent = `Question ${step + 1} of ${QUESTIONS.length}`;
    el('mood').textContent = MOODS[step] || '';
    el('fill').style.width =
      Math.round(((step + 1) / QUESTIONS.length) * 100) + '%';
    el('mascot').innerHTML = MASCOT_FACES[step % MASCOT_FACES.length]();
    el('opts').innerHTML = item.a
      .map(
        (o, i) =>
          `<button class="lt-opt" type="button" onclick="pick(${i},this)">
             <span class="lt-opt__key">${String.fromCharCode(65 + i)}</span>
             <span>${o[0]}</span>
           </button>`
      )
      .join('');
    el('note').innerHTML = NOTES[step];
    el('back').classList.toggle('hide', step === 0);
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  /* Kurze Verzoegerung nach dem Klick: die Auswahl wird sichtbar quittiert,
     bevor die naechste Frage kommt. Fuehlt sich deutlich besser an als ein
     sofortiger Sprung. */
  function pick(i, btn) {
    if (locked) return;
    locked = true;
    picks[step] = i;
    if (btn) btn.classList.add('picked');
    melden(false);
    const go = () => {
      if (step < QUESTIONS.length - 1) {
        step++;
        render();
      } else {
        finish();
      }
    };
    reduceMotion ? go() : setTimeout(go, 200);
  }

  function back() {
    if (step > 0) {
      step--;
      render();
    }
  }

  function score() {
    const s = Object.fromEntries(ORDER.map((k) => [k, 0]));
    picks.forEach((choice, qi) => {
      const weights = QUESTIONS[qi].a[choice][1];
      for (const k in weights) s[k] += weights[k];
    });
    return s;
  }

  function finish() {
    const s = score();
    const lastPick = QUESTIONS[QUESTIONS.length - 1].a[picks[picks.length - 1]][1];
    const lastKey = Object.keys(lastPick)[0];
    let best = ORDER[0];
    ORDER.forEach((k) => {
      if (s[k] > s[best]) best = k;
    });
    // Gleichstand entscheidet die Selbsteinschaetzung aus der letzten Frage
    if (s[lastKey] === s[best]) best = lastKey;

    lerntyp = best;
    melden(true);

    show('s-result');
    el('s-result').innerHTML = resultHTML(PROFILES[best], s, best);
    window.scrollTo({ top: 0, behavior: 'auto' });

    requestAnimationFrame(() => {
      const max = Math.max(...Object.values(s), 1);
      document.querySelectorAll('.lt-bar-fill').forEach((b) => {
        b.style.width = Math.round((+b.dataset.v / max) * 100) + '%';
      });
    });

    if (!reduceMotion) confetti();
    if (window.plausible) window.plausible('quiz_fertig', { props: { profil: best } });
  }

  /* Echte Rezensionen aus dem deutschen App Store. Nichts erfinden —
     Profile ohne passende Bewertung bleiben leer, dann traegt die
     Store-Gesamtbewertung. */
  const R = {
    timmi: {
      t: 'Two days before the final, study plan in two minutes — ended up with an A.',
      w: 'Timmi.bremmen · App Store',
    },
    fifi: {
      t: '"Simple, effective, and motivating" — it mostly just helps me stay organized.',
      w: 'So fifi · App Store',
    },
    dexter: {
      t: 'Finally "one app that replaces many": flashcards, translator, and voice notes all together.',
      w: 'DexterBerlin36 · App Store',
    },
  };
  const REVIEWS = {
    koenner: [],
    sammler: [R.fifi, R.dexter],
    markierer: [],
    ueberfordert: [R.timmi],
    einzel: [],
    sprinter: [R.timmi],
  };

  function resultHTML(p, s, key) {
    const d = DETAIL[key];
    const c = CONCEPT[key];

    const bars = ORDER.map(
      (k) => `
      <div class="lt-bar-row ${k === key ? 'top-hit' : ''}">
        <div>
          <div class="lt-bar-name">${PROFILES[k].short}</div>
          <div class="lt-bar-track"><span class="lt-bar-fill" data-v="${s[k]}"></span></div>
        </div>
        <span class="lt-bar-val">${s[k]} pts</span>
      </div>`
    ).join('');

    const reviews = REVIEWS[key] || [];
    const bewertungen = `
      <h3>What others say</h3>
      <div class="lt-rating">
        <span class="lt-rating-num">${STORE.schnitt}</span>
        <span>
          <span class="lt-stars">★★★★★</span>
          <span class="lt-rating-sub">${STORE.anzahl} ratings on the App&nbsp;Store · as of ${STORE.stand}</span>
        </span>
      </div>
      ${reviews
        .map(
          (r) => `<div class="lt-rev">
            <div class="lt-stars">★★★★★</div>
            <p>${r.t}</p>
            <div class="lt-who">${r.w}</div>
          </div>`
        )
        .join('')}`;

    const cta = `
      <div class="lt-store">
        <p class="lt-store__note">
          <strong>Octa is currently available for iPhone and iPad only.</strong>
          An <button class="lt-link" type="button" onclick="openWaitlist()">Android version</button>
          is in the works.
        </p>
        <div class="lt-codebox">
          <div class="lt-label">Your free month as ${p.short}</div>
          <div class="lt-code" id="thecode">${p.code}</div>
          <button class="lt-copy" type="button" onclick="copyCode()">Copy code</button>
        </div>
        <a class="btn lt-btn-block" href="${storeLink(fach)}" target="_blank" rel="noopener"
           onclick="if(window.plausible)plausible('store_klick',{props:{code:'${p.code}',fach:fach}})">Get Octa on the App Store</a>
        <p class="lt-fine"><a class="lt-link" href="/en/app/">See everything Octa can do →</a></p>
      </div>`;

    const mail = CONFIG.mailAktiv
      ? `<hr class="lt-divider">
         <div class="lt-befund" id="mailbox">
           <h3 style="margin-bottom:.4rem">Rather skip the app for now?</h3>
           <p class="text-muted">Then we'll send you your 7-day plan for ${p.name.toLowerCase()} — one task a day, 20 to 30 minutes.</p>
           <label for="mail">Email</label>
           <input id="mail" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com">
           <label for="exam">Next exam (optional)</label>
           <input id="exam" type="date">
           <button class="btn btn--ghost lt-btn-block" type="button" onclick="sendMail('${p.code}')">Send plan</button>
           <p class="lt-fine">Used only for the plan and reminders about your exam. Unsubscribe any time.</p>
         </div>`
      : '';

    return `
      <div class="lt-result-head">
        <img class="lt-result-img" src="/img/lerntypen/${key}.webp" srcset="/img/lerntypen/${key}@1x.webp 450w, /img/lerntypen/${key}.webp 900w" sizes="(max-width: 640px) 78vw, 340px" alt="Illustration: ${p.name}" />
        <span class="eyebrow">Your result</span>
        <h1 style="margin:.4rem 0 .5rem">${p.name}</h1>
        <p class="lt-tagline">${p.tagline}</p>
      </div>

      <div class="lt-befund">
        <span class="eyebrow" style="margin-bottom:1rem">Breakdown</span>
        <div class="lt-bars">${bars}</div>
      </div>

      <div class="lt-block"><h3>What you're good at</h3><p>${p.strength}</p></div>
      <div class="lt-block"><h3>Sound familiar?</h3><p class="lt-moment">${d.moment}</p></div>
      <div class="lt-block"><h3>Why this happens</h3><p>${d.why}</p></div>
      <div class="lt-block"><h3>What it's costing you</h3><p>${p.cost}</p></div>

      <hr class="lt-divider">

      <div class="lt-block">
        <span class="eyebrow">The principle</span>
        <h3 style="margin:.75rem 0 .5rem">${c.titel}</h3>
        <p>${c.was}</p>
        <div class="lt-evidence-single">
          <strong>Why it works</strong>
          <p>${c.warum}</p>
        </div>
        <p><strong>The everyday hurdle:</strong> ${c.huerde}</p>
      </div>

      <hr class="lt-divider">

      <div class="lt-block">
        <span class="eyebrow">Putting it into practice</span>
        <h3 style="margin:.75rem 0 .5rem">This is exactly why we built Octa</h3>
        <div class="lt-app">
          <div class="lt-app__text">
            <p class="lt-app__feature">${p.featureTitle}</p>
            <p>${d.why_octa}</p>
            <ol class="lt-steps">${d.how.map((x) => `<li>${x}</li>`).join('')}</ol>
          </div>
          <figure class="lt-phone">
            <img src="${mockSrc(key)}" sizes="(max-width: 720px) 60vw, 250px"
                 alt="Octa app: ${MOCKUP_CAP[key]}" loading="lazy" />
            <figcaption>${MOCKUP_CAP[key]}</figcaption>
          </figure>
        </div>
      </div>

      <div class="lt-block">
        <h3>What else Octa does</h3>
        <ul class="lt-features">
          <li>
            <strong>Upload your materials — or just type in the topic</strong>
            Lecture PDF, slides, photographed notes, or a screenshot.
            Don't have anything handy? A keyword is enough: Octa researches
            the topic itself and builds the flashcards from that.
          </li>
          <li>
            <strong>Flashcards and quizzes, automatically</strong>
            Built from your own material, in seconds. You never write a
            single card yourself.
          </li>
          <li>
            <strong>"Test yourself" on every flashcard</strong>
            Speak your answer instead of typing it. Octa listens and
            answers back out loud: what was missing, plus a memory trick
            and a tip. Strict or friendly, depending on your settings.
          </li>
          <li>
            <strong>Study plan through exam day</strong>
            Works backward from your exam date, cuts the material into
            daily portions, and brings back reviews at exactly the right
            time.
          </li>
          <li>
            <strong>Tribes</strong>
            Study groups where your progress is visible — without you
            having to report anything.
          </li>
        </ul>
      </div>

      <div class="lt-block">${bewertungen}</div>

      <hr class="lt-divider">

      ${cta}
      ${mail}

      <hr class="lt-divider">

      <button class="lt-back" type="button" onclick="location.reload()">← Take the quiz again</button>`;
  }


  /* ------------------------------------------------- Android-Warteliste -- */

  /* Wortlaut der Einwilligung. Wird mitgespeichert, damit später belegbar ist,
     wozu genau der Nutzer zugestimmt hat. Bei jeder Textänderung mitziehen. */
  const WL_EINWILLIGUNG =
    "I'd like to be notified by email as soon as the Android version of Octa is available. My email address will be used only for that and then deleted.";

  function openWaitlist() {
    const body = el('wl-body');
    if (CONFIG.waitlistEndpoint) {
      body.innerHTML = `
        <label for="wl-mail">Email</label>
        <input id="wl-mail" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com">
        <input id="wl-hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="lt-hp">
        <label class="lt-check" for="wl-consent">
          <input id="wl-consent" type="checkbox">
          <span>I'd like to be notified by email as soon as the Android version of Octa is available. My email address will be used only for that and then deleted. I've read the <a href="/datenschutz/" target="_blank" rel="noopener">privacy policy</a> (in German).</span>
        </label>
        <button class="btn" type="button" id="wl-send" onclick="sendWaitlist()">Join the waitlist</button>
        <p class="lt-msg hide" id="wl-msg"></p>
        <p class="lt-fine">No newsletter, no ads — just the one message, when it's ready.</p>`;
    } else {
      body.innerHTML = `
        <p class="lt-fine" style="margin-bottom:1rem">The waitlist is being set up right now. Until then, a quick email will do — the subject line is already set.</p>
        <a class="btn" href="mailto:${CONFIG.kontaktMail}?subject=Android-Warteliste">Sign up by email</a>`;
    }
    el('waitlist').classList.remove('hide');
    if (window.plausible) window.plausible('warteliste_geoeffnet');
  }

  function closeWaitlist() {
    el('waitlist').classList.add('hide');
  }

  function wlFehler(text) {
    const m = el('wl-msg');
    m.textContent = text;
    m.classList.remove('hide');
  }

  function sendWaitlist() {
    const feld = el('wl-mail');
    const consent = el('wl-consent');
    const knopf = el('wl-send');
    const mail = feld.value.trim();

    el('wl-msg').classList.add('hide');
    feld.style.borderColor = '';
    consent.closest('.lt-check').classList.remove('lt-check--miss');

    if (!/^\S+@\S+\.\S+$/.test(mail)) {
      feld.style.borderColor = '#E5177B';
      feld.focus();
      wlFehler("That email address doesn't look complete.");
      return;
    }
    if (!consent.checked) {
      consent.closest('.lt-check').classList.add('lt-check--miss');
      consent.focus();
      wlFehler("We can't save your address without your consent.");
      return;
    }

    knopf.disabled = true;
    knopf.textContent = 'Sending …';

    fetch(CONFIG.waitlistEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: mail,
        fach: fach || '',
        lerntyp: lerntyp || '',
        quelle: 'lerntyp-test',
        einwilligung: WL_EINWILLIGUNG,
        hp: el('wl-hp').value,
      }),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        if (!d || d.ok !== true) return Promise.reject('antwort');
        el('wl-body').innerHTML =
          "<div class=\"lt-done-note\"><strong>You're on the list.</strong><br />We'll email you the moment the Android version is ready — and never otherwise.</div>";
        if (window.plausible) window.plausible('warteliste_eingetragen');
      })
      .catch(() => {
        knopf.disabled = false;
        knopf.textContent = 'Try again';
        wlFehler(
          "That didn't go through. Try again, or email us at " +
            CONFIG.kontaktMail + '.'
        );
      });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeWaitlist();
  });
  document.getElementById('waitlist').addEventListener('click', (e) => {
    if (e.target.id === 'waitlist') closeWaitlist();
  });

  function copyCode() {
    const code = el('thecode').textContent;
    navigator.clipboard.writeText(code).then(() => {
      const b = document.querySelector('.lt-copy');
      b.textContent = 'Copied';
      setTimeout(() => (b.textContent = 'Copy code'), 1800);
    });
  }

  function sendMail(code) {
    const mail = el('mail').value.trim();
    if (!/^\S+@\S+\.\S+$/.test(mail)) {
      el('mail').style.borderColor = '#E5177B';
      el('mail').focus();
      return;
    }
    const payload = {
      email: mail,
      pruefung: el('exam').value || null,
      profil: code,
      plattform: isIOS ? 'ios' : 'andere',
      antworten: picks,
    };
    const done = () => {
      el('mailbox').innerHTML =
        '<div class="lt-done-note"><strong>On its way.</strong><br />Your plan should be in your inbox shortly — check spam if you don’t see it.</div>';
    };
    if (!CONFIG.mailEndpoint) {
      console.warn('Kein mailEndpoint gesetzt. Payload:', payload);
      done();
      return;
    }
    fetch(CONFIG.mailEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(done)
      .catch(done);
  }

  /* Konfetti — kurz, dezent, in den Markenfarben. */
  function confetti() {
    const cv = el('confetti');
    const ctx = cv.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.style.display = 'block';
    cv.width = window.innerWidth * dpr;
    cv.height = window.innerHeight * dpr;
    ctx.scale(dpr, dpr);

    const colors = ['#E5177B', '#7C6BF0', '#F0B429', '#3E9BD8', '#17B98D'];
    const parts = Array.from({ length: 90 }, (_, i) => ({
      x: window.innerWidth * (0.15 + Math.sin(i * 12.9898) * 0.5 + 0.35),
      y: -20 - (i % 12) * 24,
      r: 4 + (i % 5),
      c: colors[i % colors.length],
      vy: 2.4 + (i % 7) * 0.35,
      vx: (((i * 37) % 100) / 100 - 0.5) * 2.2,
      rot: (i * 31) % 360,
      vr: (((i * 17) % 100) / 100 - 0.5) * 9,
    }));

    let frames = 0;
    (function tick() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      parts.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.045;
        p.rot += p.vr;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rot * Math.PI) / 180);
        ctx.fillStyle = p.c;
        ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 1.7);
        ctx.restore();
      });
      frames++;
      if (frames < 190) requestAnimationFrame(tick);
      else {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        cv.style.display = 'none';
      }
    })();
  }


</script>
