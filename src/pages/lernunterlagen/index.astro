---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OctaCtaBox from '../../components/OctaCtaBox.astro';
import { OCTA } from '../../site';

const LERNPLAN_SLIDES = [
  {
    src: '/img/mockups/app/andere-plan.webp',
    alt: 'Octa-Lernplan mit Lernpfad und Fortschritt bis zur Prüfung',
    caption: 'Automatischer Lernplan',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-karte.webp',
    alt: 'Octa-Karteikarte, generiert aus hochgeladenen Unterlagen',
    caption: 'Karten aus Unterlagen',
    width: 752,
    height: 1559,
  },
];

/* "kurz" ist das Chip-Label in der Schnellauswahl oben. Der lange Titel
   bleibt fuer die ausfuehrlichen Karten weiter unten stehen — in einer
   Chip-Reihe wuerde "Wirtschaftsingenieurwesen" alles andere erschlagen. */
const faecher = [
  {
    title: 'Rechtswissenschaft',
    kurz: 'Jura',
    href: '/lernunterlagen/jura/',
    text: 'Prüfungsschemata und ausformulierte Klausurfälle zu den klassischen Klausurparagrafen — Zivilrecht, Strafrecht und Öffentliches Recht.',
    status: 'verfügbar',
  },
  { title: 'BWL & Wirtschaft', kurz: 'BWL', text: 'Kennzahlen, Buchungssätze, Schemata für die typischen Klausuraufgaben.', status: 'in Vorbereitung' },
  { title: 'Sportwissenschaften', kurz: 'Sport', text: 'Anatomie, Trainingslehre und Prüfungsstoff aus der Bewegungswissenschaft.', status: 'in Vorbereitung' },
  { title: 'Wirtschaftsingenieurwesen', kurz: 'Wirtschaftsing.', text: 'Technik trifft Betriebswirtschaft — Formelsammlungen und Rechenwege.', status: 'in Vorbereitung' },
  { title: 'Bauingenieurwesen', kurz: 'Bauing.', text: 'Statik, Baustoffkunde und die Nachweise, die in jeder Klausur drankommen.', status: 'in Vorbereitung' },
];
---

<BaseLayout
  title="Lernunterlagen"
  description="Fertige Lernunterlagen für dein Studium: vollständige Prüfungsschemata, PDFs zum Ausdrucken und Karteikarten-Decks. Kostenlos, ohne Anmeldung — und direkt in Octa weiterverwendbar."
  breadcrumbs={[{ label: 'Lernunterlagen', href: '/lernunterlagen/' }]}
  wide
>
  <div class="wrap">
    <p class="eyebrow">Lernunterlagen</p>
    <h1>Fertiges Material statt noch eines Erklärtexts.</h1>
    <p class="lead intro">
      Wer sich auf eine Prüfung vorbereitet, braucht selten noch eine Erklärung
      — die stand schon im Skript. Gebraucht wird das Material: die Struktur,
      die Gliederung, die Karten zum Abfragen. Genau das liegt hier.
    </p>

    <nav class="fachwahl" aria-label="Schnellauswahl Studienfach">
      <span class="fachwahl__label">Dein Fach:</span>
      <ul class="fachwahl__list">
        {
          faecher.map((fach) =>
            fach.href ? (
              <li><a class="chip chip--on" href={fach.href}>{fach.kurz}</a></li>
            ) : (
              <li><span class="chip chip--soon">{fach.kurz}<small>bald</small></span></li>
            )
          )
        }
      </ul>
      <p class="fachwahl__hint">
        Fertig ist bislang Jura. Die übrigen Fächer entstehen der Reihe nach —
        <a href="#faecher">weiter unten</a> steht, was jeweils geplant ist.
      </p>
    </nav>

    <h2 class="rule">Was du bekommst</h2>
    <div class="grid">
      <div class="card">
        <span class="card__tag">Struktur</span>
        <h3>Vollständige Prüfungsschemata</h3>
        <p>
          Hierarchisch aufgebaut von der ersten Prüfungsstufe bis zur letzten,
          zum Ausklappen. Mit den Definitionen der einzelnen Merkmale und den
          Zusammenhängen, die in der Klausur erwartet werden.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Zum Mitnehmen</span>
        <h3>PDF zum Ausdrucken</h3>
        <p>
          Jedes Schema als saubere Druckvorlage. Damit es beim Lernen neben
          deinem Skript oder deinen Unterlagen liegen kann statt in einem
          weiteren offenen Browser-Tab.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Zum Abfragen</span>
        <h3>Karteikarten-Decks</h3>
        <p>
          Fertige Decks zum Herunterladen — die Fragen sind schon geschrieben.
          Du sparst dir die vierzig Minuten Tipparbeit, die sonst vor dem
          eigentlichen Lernen stehen.
        </p>
      </div>
    </div>

    <h2 class="rule">Warum wir es so machen</h2>
    <div class="prose-inline">
      <p>
        Material durchzulesen fühlt sich produktiv an und ist es kaum. Was in
        der Prüfung abgefragt wird, ist nicht Wiedererkennen, sondern freies
        Abrufen — eine Fähigkeit, die man beim Lesen nie trainiert. Deshalb
        besteht hier jede Seite aus etwas, mit dem man arbeiten kann: einer
        Gliederung zum Nachvollziehen, einem Blatt zum Danebenlegen, einem Deck
        zum Abfragen.
      </p>
      <p>
        Der zweite Grund ist Ehrlichkeit über den Aufwand. Die meisten wissen,
        dass Selbstabfragen (Active Recall) besser wirkt als Markieren. Sie tun es trotzdem
        nicht, weil zwanzig Karteikarten pro Kapitel eine gute Stunde
        Schreibarbeit sind — vor dem Lernen. Genau diese Stunde nehmen wir dir
        ab.
      </p>
      <p>
        Alles ist kostenlos, ohne Anmeldung und ohne Konto.
      </p>
    </div>

    <OctaCtaBox
      id="lernplan-slides"
      title="Und daraus einen kompletten Lernplan machen"
      storeLink={OCTA.appStoreUrl}
      primaryLabel={`${OCTA.name} im App Store ansehen`}
      secondaryLabel="Erst herausfinden, wo es hakt"
      secondaryHref="/tools/lerntyp-test/"
      slides={LERNPLAN_SLIDES}
      intervalMs={4200}
    >
      Die Unterlagen von hier kannst du direkt in {OCTA.name} hochladen — Octa
      macht daraus einen Lernplan bis zu deinem Prüfungstermin und automatisch
      Karteikarten und Quizze dazu. Beim Abfragen sprichst du die Antworten
      ein und bekommst gesagt, wo sie noch schwammig waren — die Rückmeldung,
      die beim stillen Lernen fehlt.
    </OctaCtaBox>

    <h2 class="rule" id="faecher">Fächer</h2>
    <p class="section-intro">
      Wir bauen Fach für Fach auf, statt überall etwas Halbes anzubieten. Was
      fertig ist, ist vollständig.
    </p>
    <div class="grid">
      {
        faecher.map((fach) =>
          fach.href ? (
            <div class="card card--link">
              <span class="card__tag">Verfügbar</span>
              <h3><a class="card__link" href={fach.href}>{fach.title}</a></h3>
              <p>{fach.text}</p>
              <p class="card__more">Zu den Unterlagen →</p>
            </div>
          ) : (
            <div class="card card--soon">
              <span class="card__tag card__tag--soon">In Vorbereitung</span>
              <h3>{fach.title}</h3>
              <p>{fach.text}</p>
            </div>
          )
        )
      }
    </div>

    <div class="note">
      <p>
        Dir fehlt dein Fach? <a href="mailto:info@octaai.app">Schreib uns</a> —
        welche Bereiche als Nächstes entstehen, entscheiden wir danach, wonach
        tatsächlich gefragt wird.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* Schnellauswahl ganz oben: Wer mit einem Fach im Kopf herkommt, soll nicht
     erst an drei Textabschnitten vorbei. Die ausfuehrlichen Karten unten
     bleiben fuer alle, die sich erst einen Ueberblick verschaffen. */
  .fachwahl {
    margin: 1.4rem 0 2.2rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }

  .fachwahl__label {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 0.7rem;
  }

  .fachwahl__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .chip--on {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip--on:hover,
  .chip--on:focus-visible {
    background: var(--accent);
    color: #fff;
  }

  /* Geplante Faecher sind sichtbar, aber eindeutig nicht klickbar — sonst
     klickt jemand darauf und landet im Nichts. */
  .chip--soon {
    color: var(--text-subtle);
    border-style: dashed;
    cursor: default;
  }

  .chip--soon small {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }

  .fachwahl__hint {
    margin: 0.85rem 0 0;
    font-size: 0.86rem;
    color: var(--text-subtle);
  }

  .fachwahl__hint a {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .fachwahl {
      padding: 1rem;
    }

    .chip {
      font-size: 0.9rem;
      padding: 0.45rem 0.8rem;
    }
  }

  .intro {
    max-width: 44rem;
    margin-bottom: 1rem;
  }

  .prose-inline {
    max-width: 44rem;
  }

  .section-intro {
    color: var(--text-muted);
    max-width: 42rem;
    margin-top: -0.35rem;
  }

  .card__more {
    margin-top: 0.9rem;
    margin-bottom: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Geplante Faecher: sichtbar, aber klar zurueckgenommen */
  .card--soon {
    background: transparent;
    border-style: dashed;
    box-shadow: none;
  }

  .card--soon h3 {
    color: var(--text-muted);
  }

  .card--soon p {
    color: var(--text-subtle);
  }

  .card__tag--soon {
    color: var(--text-subtle);
    background: var(--bg-soft);
  }
</style>
