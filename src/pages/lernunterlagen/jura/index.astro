---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { OCTA } from '../../../site';
import schemata from '../../../data/jura-schemata.json';

const RECHTSGEBIETE = [
  {
    key: 'Zivilrecht (BGB)',
    text: 'BGB Allgemeiner Teil, Deliktsrecht, Bereicherungsrecht, Leistungsstörungen, Sachenrecht und Schuldrecht Besonderer Teil — von der Willenserklärung bis zur Übereignung.',
  },
  {
    key: 'Strafrecht (StGB)',
    text: 'Allgemeiner Teil (Versuch, Täterschaft, Rechtfertigungsgründe) und Besonderer Teil — Vermögens-, Körperverletzungs-, Tötungs- und Straßenverkehrsdelikte.',
  },
  {
    key: 'Öffentliches Recht (GG)',
    text: 'Grundrechte, Staatsorganisationsrecht und Verfassungsprozessrecht sowie die zentralen Klagearten des Verwaltungsprozessrechts.',
  },
];

function shortLabel(entry) {
  return entry.keyword.replace(/\s*Schema$/, '');
}

const groups = RECHTSGEBIETE.map((rg) => {
  const entries = schemata.filter((e) => e.rechtsgebiet === rg.key);
  const byTeilgebiet = [];
  for (const e of entries) {
    let bucket = byTeilgebiet.find((b) => b.teilgebiet === e.teilgebiet);
    if (!bucket) {
      bucket = { teilgebiet: e.teilgebiet, entries: [] };
      byTeilgebiet.push(bucket);
    }
    bucket.entries.push(e);
  }
  return { ...rg, count: entries.length, byTeilgebiet };
});

const total = schemata.length;
---

<BaseLayout
  title="Rechtswissenschaft"
  description="Vollständige juristische Prüfungsschemata zum Ausklappen und Ausdrucken — Zivilrecht, Strafrecht und Öffentliches Recht, jeweils mit PDF und Karteikarten-Deck."
  breadcrumbs={[
    { label: 'Lernunterlagen', href: '/lernunterlagen/' },
    { label: 'Rechtswissenschaft', href: '/lernunterlagen/jura/' },
  ]}
  wide
>
  <div class="wrap">
    <p class="eyebrow">Lernunterlagen</p>
    <h1>Rechtswissenschaft</h1>
    <p class="lead intro">
      {total} Prüfungsschemata, jedes vollständig aufgebaut — hierarchisch von
      der ersten Prüfungsstufe bis zur letzten, mit den Definitionen der
      Tatbestandsmerkmale und den Streitständen, die in der Klausur erwartet
      werden. Dazu jeweils ein PDF zum Ausdrucken und ein Karteikarten-Deck.
    </p>

    {
      groups.map((g) => (
        <section class="silo">
          <div class="silo__head">
            <h2>{g.key}</h2>
            <span class="silo__count">{g.count} Schemata</span>
          </div>
          <p class="silo__text">{g.text}</p>
          {g.byTeilgebiet.map((b) => (
            <div class="teilgebiet">
              <h3>{b.teilgebiet}</h3>
              <ul class="chips" aria-label={`Schemata: ${b.teilgebiet}`}>
                {b.entries.map((e) => (
                  <li>
                    <a href={`/lernunterlagen/jura/${e.slug}/`}>{shortLabel(e)} →</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }

    <h2 class="rule">Wie eine Schema-Seite aufgebaut ist</h2>
    <ol>
      <li>
        <strong>Das vollständige Schema</strong> — hierarchisch gegliedert und
        ausklappbar, damit du erst die Struktur siehst und dann die Details.
      </li>
      <li>
        <strong>Definitionen</strong> aller Tatbestandsmerkmale, in der Fassung,
        die in der Klausur erwartet wird.
      </li>
      <li>
        <strong>Streitstände und typische Probleme</strong> — knapp und auf das
        beschränkt, was tatsächlich klausurrelevant ist.
      </li>
      <li>
        <strong>PDF zum Ausdrucken</strong>, damit das Schema neben dem Gesetz
        liegen kann statt in einem weiteren offenen Tab.
      </li>
      <li>
        <strong>Karteikarten-Deck</strong> zum Herunterladen — und wenn du
        möchtest, direkt in {OCTA.name} zur mündlichen Abfrage.
      </li>
    </ol>

    <div class="note">
      <p>
        Alle Inhalte dienen ausschließlich der Vorbereitung auf Prüfungen. Sie
        stellen keine Rechtsberatung dar und ersetzen keine anwaltliche
        Beratung im Einzelfall.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 44rem;
    margin-bottom: 2.2rem;
  }

  .silo {
    margin-bottom: 2.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .silo:last-of-type {
    border-bottom: none;
  }

  .silo__head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .silo__head h2 {
    margin: 0;
  }

  .silo__count {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 100px;
    padding: 0.15rem 0.65rem;
  }

  .silo__text {
    max-width: 50rem;
    color: var(--text-muted);
    margin: 0.5rem 0 1.3rem;
  }

  .teilgebiet {
    margin-bottom: 1.1rem;
  }

  .teilgebiet:last-child {
    margin-bottom: 0;
  }

  .teilgebiet h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
    margin: 0 0 0.5rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips li {
    margin-top: 0;
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }

  .chips li a {
    display: inline-block;
    text-decoration: none;
    color: var(--accent);
    border: 1px solid var(--accent-soft);
    background: var(--accent-soft);
    border-radius: 100px;
    padding: 0.15rem 0.6rem;
    font-weight: 700;
  }

  .chips li a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
