---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { OCTA } from '../../../site';

const silos = [
  {
    title: 'Zivilrecht (BGB)',
    slug: 'zivilrecht',
    text: 'Deliktsrecht, Bereicherungsrecht, Leistungsstörungen, Sachenrecht — von § 823 BGB über § 812 BGB bis zur Übereignung nach § 929 BGB.',
    examples: [
      { label: '§ 823 I BGB', href: '/lernunterlagen/jura/823-bgb/' },
      { label: '§ 985 BGB', href: '/lernunterlagen/jura/985-bgb/' },
      { label: '§ 812 BGB', href: '/lernunterlagen/jura/812-bgb/' },
      { label: '§ 280 BGB', href: '/lernunterlagen/jura/280-bgb/' },
      { label: '§ 929 BGB', href: '/lernunterlagen/jura/929-bgb/' },
    ],
  },
  {
    title: 'Strafrecht (StGB)',
    slug: 'strafrecht',
    text: 'Die klassischen Klausurdelikte mit vollständigem Aufbau: objektiver und subjektiver Tatbestand, Rechtswidrigkeit, Schuld, Strafzumessung.',
    examples: [
      { label: '§ 263 StGB', href: '/lernunterlagen/jura/263-stgb/' },
      { label: '§ 242 StGB', href: '/lernunterlagen/jura/242-stgb/' },
      { label: '§ 223 StGB', href: '/lernunterlagen/jura/223-stgb/' },
      { label: '§ 315c StGB', href: '/lernunterlagen/jura/315c-stgb/' },
      { label: '§ 32 StGB (Notwehr)', href: '/lernunterlagen/jura/notwehr/' },
    ],
  },
  {
    title: 'Öffentliches Recht (GG)',
    slug: 'oeffentliches-recht',
    text: 'Grundrechtsprüfung und Verfassungsprozessrecht — Schutzbereich, Eingriff, Rechtfertigung, und die Zulässigkeit der Verfassungsbeschwerde.',
    examples: [{ label: 'Grundrechtsprüfung' }, { label: 'Verfassungsbeschwerde' }],
  },
];
---

<BaseLayout
  title="Rechtswissenschaft"
  description="Vollständige juristische Prüfungsschemata zum Ausklappen und Ausdrucken — Zivilrecht, Strafrecht und Öffentliches Recht, jeweils mit PDF und Karteikarten-Deck."
  breadcrumbs={[
    { label: 'Lernunterlagen', href: '/lernunterlagen/' },
    { label: 'Rechtswissenschaft', href: '/lernunterlagen/jura/' },
  ]}
  wide
>
  <div class="wrap">
    <p class="eyebrow">Lernunterlagen</p>
    <h1>Rechtswissenschaft</h1>
    <p class="lead intro">
      Jedes Schema hier ist vollständig aufgebaut — hierarchisch von der ersten
      Prüfungsstufe bis zur letzten, mit den Definitionen der
      Tatbestandsmerkmale und den Streitständen, die in der Klausur erwartet
      werden. Dazu jeweils ein PDF zum Ausdrucken und ein Karteikarten-Deck.
    </p>

    <div class="grid">
      {
        silos.map((silo) => (
          <div class="card">
            <h3>{silo.title}</h3>
            <p>{silo.text}</p>
            <ul class="chips" aria-label={`Schemata: ${silo.title}`}>
              {silo.examples.map((ex) =>
                ex.href ? (
                  <li><a href={ex.href}>{ex.label} →</a></li>
                ) : (
                  <li>{ex.label}</li>
                )
              )}
            </ul>
          </div>
        ))
      }
    </div>

    <h2 class="rule">Wie eine Schema-Seite aufgebaut ist</h2>
    <ol>
      <li>
        <strong>Das vollständige Schema</strong> — hierarchisch gegliedert und
        ausklappbar, damit du erst die Struktur siehst und dann die Details.
      </li>
      <li>
        <strong>Definitionen</strong> aller Tatbestandsmerkmale, in der Fassung,
        die in der Klausur erwartet wird.
      </li>
      <li>
        <strong>Streitstände und typische Probleme</strong> — knapp und auf das
        beschränkt, was tatsächlich klausurrelevant ist.
      </li>
      <li>
        <strong>PDF zum Ausdrucken</strong>, damit das Schema neben dem Gesetz
        liegen kann statt in einem weiteren offenen Tab.
      </li>
      <li>
        <strong>Karteikarten-Deck</strong> zum Herunterladen — und wenn du
        möchtest, direkt in {OCTA.name} zur mündlichen Abfrage.
      </li>
    </ol>

    <div class="note">
      <p>
        Alle Inhalte dienen ausschließlich der Vorbereitung auf Prüfungen. Sie
        stellen keine Rechtsberatung dar und ersetzen keine anwaltliche
        Beratung im Einzelfall.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chips li {
    margin-top: 0;
    font-size: 0.82rem;
    font-family: var(--font-mono);
  }

  .chips li,
  .chips li a {
    color: var(--text-muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.15rem 0.6rem;
  }

  .chips li a {
    display: inline-block;
    text-decoration: none;
    color: var(--accent);
    border-color: var(--accent-soft);
    background: var(--accent-soft);
    font-weight: 700;
  }

  .chips li a:hover {
    background: var(--accent);
    color: #fff;
  }
</style>
