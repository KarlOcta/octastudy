---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OctaCtaBox from '../../components/OctaCtaBox.astro';
import MockupSlideshow from '../../components/MockupSlideshow.astro';
import AndroidWarteliste from '../../components/AndroidWarteliste.astro';
import { OCTA, APP_RATING, APP_REVIEWS, SITE } from '../../site';

const HERO_SLIDES = [
  {
    src: '/img/mockups/app/andere-test.webp',
    alt: 'Octa-Karteikarte mit Button "Test yourself" — die Antwort wird laut gesprochen',
    caption: 'Antwort einsprechen',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-plan.webp',
    alt: 'Octa-Lernplan mit Lernpfad und Fortschritt bis zur Prüfung',
    caption: 'Automatischer Lernplan',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-karte.webp',
    alt: 'Octa-Karteikarte, generiert aus hochgeladenen Vorlesungsunterlagen',
    caption: 'Karten aus Unterlagen',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-tribes.webp',
    alt: 'Octa-Tribes-Bildschirm mit wöchentlicher Bestenliste von Lerngruppen',
    caption: 'Fortschritt in Tribes',
    width: 752,
    height: 1559,
  },
];

const ICONS = {
  cards: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M7 4h11a2 2 0 0 1 2 2v9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M7 11h6M7 14h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  mic: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M5 11a7 7 0 0 0 14 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 18v3M9 21h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.3" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4.7" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/></svg>`,
  bulb: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18h6M10 21h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 3a6.3 6.3 0 0 0-3.7 11.4c.6.43 1 .9 1.1 1.7h5.2c.1-.8.5-1.27 1.1-1.7A6.3 6.3 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12a8 8 0 1 1 3.2 6.4L4 20l1.1-3.4A7.96 7.96 0 0 1 4 12Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 10.1c0-1.1.9-1.9 2-1.9s2 .78 2 1.75c0 1.45-1.8 1.45-1.8 3.05" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12.15" cy="15.9" r="0.9" fill="currentColor"/></svg>`,
  group: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.5" cy="8.5" r="2.7" stroke="currentColor" stroke-width="1.7"/><circle cx="16.2" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.7"/><path d="M3.4 19c.4-3 2.4-4.8 5.1-4.8s4.6 1.8 5 4.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M14.5 14.6c2.2.25 3.8 1.85 4.1 4.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
};

const FEATURES = [
  {
    title: 'Aus deinen Unterlagen werden Karteikarten',
    text: 'Lade Vorlesungsfolien, ein eingescanntes Skript hoch oder tipp einfach das Thema ein. Octa liest es und baut daraus Karteikarten — ohne dass du Fragen von Hand eintippen musst.',
    icon: ICONS.cards,
    tint: 'purple',
  },
  {
    title: '"Test yourself" — laut gesprochen, nicht nur erkannt',
    text: 'Jede Karteikarte hat einen "Test yourself"-Button. Du sprichst deine Antwort laut ein, statt sie nur auf dem Bildschirm wiederzuerkennen, und bekommst echtes gesprochenes Feedback dazu, was du richtig hattest und was nicht.',
    icon: ICONS.mic,
    tint: 'pink',
  },
  {
    title: 'Ein Lernplan auf deine Wunschnote zugeschnitten',
    text: 'Lade deine Unterlagen hoch und gib an, welche Note du anstrebst. Daraus baut Octa einen Lernplan — kurz und fokussiert, wenn es nur zum Bestehen reichen soll, oder intensiver, wenn du höher hinaus willst — und setzt die Wiederholungen genau dann an, wenn du kurz davor bist, den Stoff wieder zu vergessen, statt einer einzigen langen Lernnacht.',
    icon: ICONS.target,
    tint: 'mint',
  },
  {
    title: 'Ein KI-Tutor, der die Lösung wirklich erklärt',
    text: 'Karteikarte falsch oder nur halb richtig? Octas KI-Tutor zeigt dir nicht bloß die richtige Antwort, sondern erklärt ausführlich, warum sie richtig ist — so intensiv, wie du es gerade brauchst.',
    icon: ICONS.bulb,
    tint: 'yellow',
  },
  {
    title: 'Frag ihn alles zu deinen Unterlagen',
    text: 'Über die Karteikarten hinaus beantwortet Octas KI-Tutor konkrete Fragen zu allem, was du hochgeladen hast, und löst Aufgaben mit dir Schritt für Schritt — wie ein Tutor, der deine Vorlesungsunterlagen tatsächlich gelesen hat.',
    icon: ICONS.chat,
    tint: 'purple',
  },
  {
    title: 'Tribes — sichtbarer Fortschritt statt guter Vorsätze',
    text: 'Tritt einer Tribe aus Studierenden bei, die auf dieselbe Art Prüfung hinarbeiten. Deine Lernsessions tauchen dort automatisch auf — ein ausgelassener Tag fällt der Gruppe also tatsächlich auf.',
    icon: ICONS.group,
    tint: 'pink',
  },
];

/** Wiedererkennbare Momente statt abstrakter Problembeschreibung. Stehen
 *  bewusst vor den Features: Erst der Grund, dann die Mechanik. */
const PROBLEM = [
  'Du liest das Kapitel zum dritten Mal. Es kommt dir alles bekannt vor. Ob du es erklären könntest, hast du nie ausprobiert.',
  'Du drehst die Karteikarte um, nickst innerlich „wusste ich" und legst sie auf den Fertig-Stapel. Ausgesprochen hast du die Antwort nie.',
  'Zwei Tage vor der Prüfung merkst du, dass die Hälfte vom Anfang wieder weg ist. Also fängst du nochmal von vorne an.',
];

/** Der Mechanismus in drei Schritten — die ausführliche Feature-Liste
 *  kommt später als Beleg, nicht als Einstieg. */
const STEPS = [
  {
    title: 'Du lädst hoch, was du ohnehin hast',
    text: 'Vorlesungsfolien, ein Skript, ein Foto deiner Notizen. Octa liest das und baut daraus Karteikarten. Du tippst keine einzige Frage selbst.',
  },
  {
    title: 'Du wirst abgefragt — laut',
    text: 'Die Lösung erscheint erst, wenn du geantwortet hast: gesprochen, nicht angeklickt. Danach hörst du, was gefehlt hat. Wer eine mündliche Prüfung vor sich hat, übt damit nebenbei genau die Situation, um die es dort geht.',
  },
  {
    title: 'Die Wiederholung kommt, wenn sie nötig ist',
    text: 'Du gibst deinen Prüfungstermin und deine Wunschnote an. Octa verteilt die Wiederholungen darauf — jede Karte kommt zurück, kurz bevor du sie vergessen hättest.',
  },
];

/** Antwort auf den Einwand, den heute jeder Besucher mitbringt. */
const CONTRA = [
  {
    title: 'Es weiß nicht, was du vergessen hast',
    text: 'ChatGPT führt kein Protokoll darüber, welche Karte du letzte Woche nicht konntest, und meldet sich nicht, wenn sie wieder fällig wäre. Du müsstest selbst wissen, was wann dran ist — also genau die Arbeit machen, die du abgeben wolltest.',
  },
  {
    title: 'Du tippst, statt zu sprechen',
    text: 'Getipptes darf ungefähr bleiben, und bewertet hast du dich am Ende wieder selbst. Genau die Selbsteinschätzung ist aber die Stelle, an der Lernen kippt.',
  },
  {
    title: 'Dein Stoff ist dort nur ein Anhang',
    text: 'Jede neue Sitzung beginnt damit, dass du den Kontext erneut einfügst. Es gibt keinen Bestand, gegen den systematisch geprüft wird, und keinen Überblick darüber, wo du schwach bist.',
  },
  {
    title: 'Es gibt keinen Termin und keine Gruppe',
    text: 'Kein Plan, der auf deine Prüfung zuläuft, und niemand, dem auffällt, dass du drei Tage nicht da warst.',
  },
];

const FAQ = [
  {
    q: 'Auf welchen Geräten läuft Octa?',
    a: 'Octa gibt es aktuell nur für iPhone und iPad. Eine Android-Version ist in Arbeit — auf dieser Seite kannst du dich auf die Warteliste setzen und bekommst genau eine Nachricht, sobald sie da ist.',
  },
  {
    q: 'Woher kommen die Karteikarten?',
    a: 'Aus deinen eigenen Unterlagen. Lade ein PDF, Folien oder ein Foto deiner Notizen hoch, oder tipp einfach ein Thema ein — Octa baut daraus Karteikarten, statt dir ein generisches Deck vorzusetzen, das nicht zu deinem Kurs passt.',
  },
  {
    q: 'Funktioniert das auch für mein Fach?',
    a: 'Octa arbeitet mit dem, was du hochlädst, und ist nicht auf ein Fach beschränkt. Im Einsatz sind bereits unter anderem Jura, BWL, Medizin, Informatik und Ingenieurwissenschaften.',
  },
  {
    q: 'Was kostet Octa?',
    a: 'Der Preis steht direkt im App-Store-Eintrag, bevor du die App herunterlädst.',
  },
  {
    q: 'Was ist der Unterschied zu Anki oder Quizlet?',
    a: 'Anki und Quizlet basieren auf Karten, die du (oder jemand anders) bereits von Hand geschrieben hat. Octa baut die Karten aus deinen eigenen Unterlagen, ergänzt lautes Selbst-Abfragen statt bloßem Umdrehen der Karte, und setzt die Wiederholungen automatisch für dich an, statt dir die Planung manuell zu überlassen.',
  },
  {
    q: 'Warum nicht einfach ChatGPT zum Abfragen nutzen?',
    a: 'Für eine einzelne Frage funktioniert das gut. Was fehlt, ist alles, was daraus ein Lernsystem macht: ChatGPT merkt sich nicht, welche Karte du letzte Woche nicht konntest, terminiert keine Wiederholungen, lässt dich tippen statt sprechen und kennt weder deinen Prüfungstermin noch deinen Stoff als dauerhaften Bestand. Du müsstest die Organisation weiterhin selbst übernehmen.',
  },
  {
    q: 'Was macht der KI-Tutor genau?',
    a: 'Zwei Dinge. Bei einer Karteikarte erklärt er die richtige Antwort ausführlich, wenn du sie falsch oder nur halb richtig hattest, statt sie dir nur anzuzeigen. Zusätzlich kannst du ihm direkte Fragen zu deinen eigenen Unterlagen stellen oder mit ihm eine Aufgabe durchgehen — er kennt nur das, was du ihm gegeben hast, keine generische Antwort von irgendwoher.',
  },
];

const storeLink = OCTA.appStoreUrl;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/app/#faq`,
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<BaseLayout
  title="Octa — Die KI-Lern-App für Karteikarten & mündliches Selbst-Abfragen"
  description="Octa macht aus deinen eigenen Unterlagen Karteikarten, fragt dich laut ab und setzt die Wiederholungen an, bevor du etwas vergisst. Kostenlos testen auf iPhone und iPad."
  breadcrumbs={[{ label: 'Die App', href: '/app/' }]}
  altHref="/en/app/"
  wide
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <section class="hero">
    <div class="hero__inner wrap">
      <div class="hero__copy">
        <p class="eyebrow">Für alle, die den Stoff wirklich behalten müssen</p>
        <h1>Stoff, den du <span class="hl">abrufen</span> kannst — nicht nur einmal gelesen hast</h1>
        <p class="lead">
          Drei Wochen gelernt, alles mehrfach gelesen — und in der Prüfung
          kommst du trotzdem nicht drauf. Das liegt selten an zu wenig Zeit.
          Es liegt daran, dass sich Wiedererkennen anfühlt wie Können.{' '}
          {OCTA.name} fragt dich so lange ab, bis du den Unterschied merkst.
        </p>
        <div class="btn-row">
          <a class="btn" href={storeLink} rel="noopener">Octa im App Store ansehen</a>
          <a class="btn btn--ghost" href="/tools/lerntyp-test/">Erst den 1-Minuten-Test machen</a>
        </div>
        <p class="hero__hint">
          iPhone und iPad · Android ist in Arbeit —{' '}
          <button class="owl-link" type="button" onclick="octaWlOpen()"
            >sag mir Bescheid, wenn es so weit ist</button
          >
        </p>
      </div>
      <div class="hero__mockup">
        <MockupSlideshow id="hero-slides" slides={HERO_SLIDES} intervalMs={4200} />
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">Kennst du das?</h2>
    <div class="beats">
      {PROBLEM.map((t) => <p class="beat">{t}</p>)}
    </div>
    <p class="beats__fazit">
      Der gemeinsame Nenner: Geprüft hat dich nie jemand — du hast dich immer
      nur selbst eingeschätzt. Genau an dieser Stelle kippt Lernen.
    </p>
  </section>

  <section class="wrap">
    <div class="celebrate">
      <div class="celebrate__art">
        <img
          src="/img/app/celebrate-graduates.webp"
          alt="Zwei Studentinnen lachen ausgelassen zusammen im Arm, eine trägt einen Doktorhut"
          width="900"
          height="1200"
          loading="lazy"
        />
      </div>
      <div class="celebrate__copy">
        <h2>Das Gefühl, wenn's gesessen hat</h2>
        <p>
          Der Moment nach der Klausur, in dem du merkst: Es hat gesessen. Genau
          darauf ist Octa ausgelegt — nicht auf ein weiteres Tool, sondern
          darauf, dass du in dem Moment ankommst.
        </p>
        <div class="celebrate__stat">
          <span class="celebrate__rating">{APP_RATING.de.schnitt} ★</span>
          <span class="celebrate__rating-sub">
            {APP_RATING.de.anzahl} Bewertungen im App Store · Stand {APP_RATING.de.stand}
          </span>
        </div>
        <blockquote class="celebrate__quote">
          „{APP_REVIEWS.de[0].t}"
          <cite>{APP_REVIEWS.de[0].w}, App-Store-Rezension</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">Wie Octa das macht</h2>
    <ol class="steps">
      {
        STEPS.map((s, i) => (
          <li class="step">
            <span class="step__nr">{i + 1}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap">
    <div class="octa-cta">
      <h2>Warum wir es so gebaut haben</h2>
      <p>
        Nochmal lesen und Markieren fühlt sich nach Fortschritt an, gehört
        laut einer großen Übersichtsstudie zu Lerntechniken aber zu den am
        wenigsten wirksamen Methoden — während Selbst-Abfragen und über
        mehrere Tage verteilte Wiederholung durchgehend zu den wirksamsten
        zählen. Octa ist genau um diese beiden Techniken herum gebaut, statt
        dir zuzumuten, sie nebenbei von Hand selbst zu organisieren.
        <cite>Dunlosky et al., Psychological Science in the Public Interest,
        2013</cite>
      </p>
      <div class="btn-row">
        <a class="btn" href={storeLink} rel="noopener">Octa im App Store ansehen</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">Alles, was drinsteckt</h2>
    <p class="section-intro">
      Alles zusammen in einer App — statt mehrerer Werkzeuge, die man
      nebeneinander benutzen muss.
    </p>
    <div class="grid">
      {
        FEATURES.map((f) => (
          <div class="card">
            <div class={`card__icon card__icon--${f.tint}`} set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">„Das kann ich mir doch von ChatGPT abfragen lassen"</h2>
    <p class="section-intro">
      Kannst du — und für eine einzelne Frage ist es gut darin. Was fehlt, ist
      alles, was aus Abfragen ein Lernsystem macht.
    </p>
    <div class="grid">
      {
        CONTRA.map((c) => (
          <div class="card">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))
      }
    </div>
    <p class="contra__fazit">
      ChatGPT beantwortet jede Frage, die du stellst. Ein Lernsystem stellt dir
      die Fragen, die du nicht stellen würdest — weil du nicht weißt, dass du
      sie nicht kannst.
    </p>
  </section>

  <section class="wrap">
    <h2 class="rule">Häufige Fragen</h2>
    <div class="faq">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="faq-more">
      Ausführlicher im Vergleich: <a href="/blog/anki-alternative/">Anki-Alternative</a>{' '}
      und <a href="/blog/quizlet-alternative/">Quizlet-Alternative</a>. Zur Einordnung von
      KI beim Lernen: <a href="/blog/karteikarten-app-ki/">Karteikarten-App mit KI</a>.
    </p>
  </section>

  <section class="wrap">
    <div class="android">
      <div class="android__copy">
        <h2>Du bist auf Android?</h2>
        <p>
          Dann kannst du Octa gerade noch nicht nutzen — die App gibt es bisher
          nur für iPhone und iPad. Die Android-Fassung wird gebaut. Trag deine
          E-Mail ein und du bekommst genau eine Nachricht, sobald sie da ist:
          kein Newsletter, keine Werbung.
        </p>
        <button class="btn btn--ghost" type="button" onclick="octaWlOpen()">
          Auf die Warteliste
        </button>
      </div>
    </div>
  </section>

  <section class="wrap">
    <OctaCtaBox
      id="closing-slides"
      title="Lade dein erstes Unterlagen-Set hoch"
      storeLink={storeLink}
      primaryLabel="Octa im App Store ansehen"
      secondaryLabel="Zum Lerntyp-Test"
      secondaryHref="/tools/lerntyp-test/"
      slides={HERO_SLIDES.slice(0, 3)}
      intervalMs={4200}
    >
      Zehn Minuten, ein Thema — genug, um zu merken, ob sich lautes
      Selbst-Abfragen wirklich anders anfühlt als nochmal die Notizen zu
      lesen.
    </OctaCtaBox>
  </section>

  <AndroidWarteliste quelle="app-landingpage" />
</BaseLayout>

<style>
  /* Android-Block: bewusst zurueckgenommen statt als zweite Haupt-CTA — er
     richtet sich an die Minderheit, die gerade gar nicht kaufen kann. */
  .android {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    padding: 1.8rem;
  }

  .android__copy {
    max-width: 42rem;
  }

  .android h2 {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
  }

  .android p {
    margin: 0 0 1.2rem;
    color: var(--text-muted);
  }

  .hero {
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
    padding-block: 0.5rem 2.5rem;
  }

  /* Problem-Abschnitt: drei wiedererkennbare Momente. Bewusst schlichter
     als die Feature-Karten — sie sollen wie Beobachtungen wirken, nicht
     wie Produktnutzen. */
  .beats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.2rem;
  }

  .beat {
    margin: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--brand-pink);
    color: var(--text-muted);
  }

  .beats__fazit {
    max-width: 44rem;
    margin-top: 1.6rem;
    font-weight: 600;
  }

  /* Mechanismus in drei nummerierten Schritten. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
    max-width: 48rem;
  }

  .step {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .step__nr {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    font-weight: 800;
    color: var(--accent);
  }

  .step h3 {
    margin: 0.2rem 0 0.35rem;
  }

  .step p {
    margin: 0;
    color: var(--text-muted);
  }

  .contra__fazit {
    max-width: 44rem;
    margin-top: 1.6rem;
    font-weight: 600;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 2.5rem;
    align-items: center;
    max-width: min(var(--w-wide), 100%);
  }

  .hero__copy h1 {
    margin-bottom: 1.1rem;
  }

  .hero__mockup {
    /* Explizite Breite statt nur max-width: Als Flex-Kind mit
       justify-self: center schrumpft die Box sonst auf ihren
       Inhalt (die Bildunterschrift!) statt eine feste Breite zu
       halten — kürzere Captions machten dadurch das ganze Mockup
       kleiner und liessen die Slideshow beim Rotieren "springen". */
    width: min(260px, 100%);
    justify-self: center;
  }

  .hero__hint {
    margin: 0.9rem 0 0;
    font-size: 0.92rem;
    color: var(--text-subtle);
  }

  .section-intro {
    color: var(--text-muted);
    max-width: 40rem;
    margin-top: -0.35rem;
    margin-bottom: 1.4rem;
  }

  .celebrate {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 2rem;
