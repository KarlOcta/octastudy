---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OCTA } from '../site';

/** Fächer mit eigenem Content-Cluster. */
const faecher = [
  {
    title: 'Rechtswissenschaft',
    href: '/schemata/',
    text: 'Prüfungsschemata zu den klassischen Klausurparagrafen — vollständig aufgebaut, mit Definitionen, Streitständen, PDF und Karteikarten-Deck.',
    status: 'live',
  },
];

/** Geplante Fächer — nur als Ausblick, bewusst ohne eigene Kachel. */
const geplant = [
  'BWL & Wirtschaft',
  'Sportwissenschaften',
  'Wirtschaftsingenieurwesen',
  'Bauingenieurwesen',
];
---

<BaseLayout
  title="Startseite"
  description="Lernmaterial für dein Studium: fertige Prüfungsschemata, PDFs zum Ausdrucken, Karteikarten-Decks und kostenlose Lerntools. Ohne Anmeldung, direkt nutzbar."
  wide
>
  <section class="hero">
    <div class="hero__inner wrap">
      <p class="eyebrow">Lernmaterial für dein Studium</p>
      <h1>Material, mit dem du <span class="hl">tatsächlich</span> lernst.</h1>
      <p class="lead">
        Kein weiterer Artikel, der dir dein Thema erklärt — das stand schon im
        Skript. Hier liegt das, womit in der Prüfungsvorbereitung wirklich
        gearbeitet wird: fertige Schemata, PDFs zum Ausdrucken,
        Karteikarten-Decks und Rechner, die dir Arbeit abnehmen. Kostenlos und
        ohne Anmeldung.
      </p>
    </div>
  </section>

  <section class="wrap">
    <h2 class="rule">Fächer</h2>
    <div class="grid">
      {
        faecher.map((fach) => (
          <a class="card" href={fach.href}>
            <span class="card__tag">Verfügbar</span>
            <h3>{fach.title}</h3>
            <p>{fach.text}</p>
            <p class="card__more">Zu den Schemata →</p>
          </a>
        ))
      }
    </div>
    <p class="upcoming">
      <span class="upcoming__label">In Vorbereitung:</span>
      {geplant.join(' · ')}
    </p>
  </section>

  <section class="wrap">
    <h2 class="rule">Tools</h2>
    <p class="section-intro">
      Fachunabhängig, laufen komplett in deinem Browser — deine Eingaben
      verlassen dein Gerät nicht.
    </p>
    <div class="grid">
      <a class="card" href="/tools/#notendurchschnitt-rechner">
        <h3>Notendurchschnitt-Rechner</h3>
        <p>
          Gewichteter Schnitt aus deinen Modulnoten — Bachelor, Master, Abitur.
        </p>
      </a>
      <a class="card" href="/tools/#lerntyp-test">
        <h3>Lerntyp-Test</h3>
        <p>
          Acht Fragen, sechs Profile — und eine konkrete Empfehlung, wie du dein
          Material aufbereiten solltest.
        </p>
      </a>
    </div>
  </section>

  <section class="wrap">
    <div class="octa-cta">
      <h2>Gelesen ist nicht gekonnt</h2>
      <p>
        Material durchzuarbeiten heißt nicht, es zu können. {OCTA.pitch} Lade
        dein Skript oder ein PDF von hier hoch — die Karteikarten entstehen
        automatisch, und du sprichst die Antworten laut, statt sie stumm zu
        überfliegen.
      </p>
      <div class="btn-row">
        <a class="btn" href={OCTA.appStoreUrl} rel="noopener">
          {OCTA.name} im App Store ansehen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Schlichter Hintergrund — Farbe kommt ueber Boxen und Balken in die Seite,
     nicht ueber grossflaechige Verlaeufe. */
  .hero {
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    padding-block: 0.5rem 3rem;
  }

  .hero__inner {
    max-width: min(var(--w-wide), 100%);
  }

  .hero__inner > * {
    max-width: 42rem;
  }

  .hero h1 {
    margin-bottom: 1.1rem;
  }

  .section-intro {
    color: var(--text-muted);
    max-width: 40rem;
    margin-top: -0.35rem;
  }

  .card__more {
    margin-top: 0.9rem;
    margin-bottom: 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .upcoming {
    margin-top: 0.25rem;
    color: var(--text-subtle);
    font-size: 0.95rem;
  }

  .upcoming__label {
    font-weight: 650;
    color: var(--text-muted);
    margin-right: 0.4em;
  }

  section + section {
    margin-top: 2.5rem;
  }
</style>
