           <ellipse cx="47" cy="50" rx="11" ry="12.5" fill="#FFF"/><circle cx="48.5" cy="51" r="5.4" fill="${INK}"/><circle cx="46.4" cy="48.4" r="1.9" fill="#FFF"/>
           <path d="M65 51 q8 -8 16 0" stroke="${INK}" stroke-width="3.4" fill="none" stroke-linecap="round"/>
