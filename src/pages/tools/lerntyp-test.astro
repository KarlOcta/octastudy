      huerde: 'Den richtigen Wiederholungsabstand triffst du von Hand nicht — zu früh bringt nichts, zu spät ist es weg. Du müsstest für jede Karte mitführen, wann sie wieder dran ist.',
    },
  };

  /* Passender App-Screenshot je Profil. */
  const MOCKUP_CAP = {
    koenner: '„Test yourself“ auf der Karte — du sprichst die Antwort ein',
    sammler: 'Aus dem gesammelten Material wird ein geordneter Lernplan',
    markierer: 'Karteikarte aus deinem eigenen Material — abrufen statt wiederlesen',
    ueberfordert: 'Der Lernplan zeigt, was heute dran ist — eine Aufgabe',
    einzel: 'Tribes — dein Fortschritt ist für die Gruppe sichtbar',
    sprinter: 'Der Lernplan verteilt den Stoff über mehrere Tage, rechtzeitig vor dem Vergessen',
  };

  /* ------------------------------------------------------------- Logik -- */

  const ORDER = ['koenner', 'sammler', 'markierer', 'ueberfordert', 'einzel', 'sprinter'];
  let step = 0;
  let picks = [];
  let locked = false;
  let fach = 'andere';
  let lerntyp = '';
  /* 'A' = normales Typ-Ergebnis, 'B' = kein klarer Bruchpunkt,
     'C' = der Test beschreibt diese Person nicht. Siehe finish(). */
  let zustand = 'A';

  /* ------------------------------------------ anonyme Durchlaufstatistik --
     `laufId` entsteht bei jedem Seitenaufruf neu und wird nirgends abgelegt —
     kein Cookie, kein localStorage. Sie verbindet nur die Meldungen desselben
     Durchlaufs miteinander und ist beim naechsten Besuch eine andere. Damit
     entstehen anonyme Zahlen, keine personenbezogenen Daten. */
  const laufId = (() => {
    try {
      if (crypto && crypto.randomUUID) return crypto.randomUUID();
    } catch (e) {}
    return 'l-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
  })();
  let laufStart = 0;
  let zuletztGemeldet = -1;

  const geraeteArt = () => {
    const ua = navigator.userAgent;
    if (/iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1))
      return 'ios';
    if (/Android/.test(ua)) return 'android';
    if (/Mobi/.test(ua)) return 'andere';
    return 'desktop';
  };

  function melden(fertig) {
    if (!CONFIG.statistikEndpoint || !laufStart) return;
    const schritt = picks.filter((p) => p !== undefined && p !== null).length;
    if (!fertig && schritt === zuletztGemeldet) return;
    zuletztGemeldet = fertig ? 99 : schritt;
    const daten = JSON.stringify({
      lauf: laufId,
      fach: fach,
      schritt: schritt,
      abgeschlossen: fertig ? 1 : 0,
      lerntyp: fertig ? lerntyp : '',
      antworten: picks.map((p) => (p === undefined || p === null ? '' : p)).join(','),
      dauer_sek: Math.round((Date.now() - laufStart) / 1000),
      geraet: geraeteArt(),
    });
    try {
      /* sendBeacon blockiert nichts und kommt auch beim Verlassen der Seite
         noch an. Als Blob mit text/plain, damit kein Preflight noetig ist. */
      if (navigator.sendBeacon) {
        navigator.sendBeacon(CONFIG.statistikEndpoint, new Blob([daten], { type: 'text/plain' }));
        return;
      }
      fetch(CONFIG.statistikEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: daten,
        keepalive: true,
      }).catch(() => {});
    } catch (e) {}
  }

  window.addEventListener('pagehide', () => melden(false));
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') melden(false);
  });

  const isIOS =
    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

  const reduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const el = (id) => document.getElementById(id);
  const show = (id) =>
    document
      .querySelectorAll('.lt-screen')
      .forEach((s) => s.classList.toggle('on', s.id === id));

  function start() {
    el('faecher').innerHTML = FAECHER.map(
      ([k, label], i) =>
        `<button class="lt-fach" type="button" onclick="pickFach('${k}',this)">${label}</button>`
    ).join('');
    el('mascot-fach').innerHTML = octo('mascot', 'curious');
    show('s-fach');
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  function pickFach(k, btn) {
    if (locked) return;
    locked = true;
    fach = k;
    if (btn) btn.classList.add('picked');
    if (window.plausible) window.plausible('fach_gewaehlt', { props: { fach: k } });
    laufStart = Date.now();
    melden(false);
    const go = () => {
      locked = false;
      show('s-quiz');
      render();
    };
    reduceMotion ? go() : setTimeout(go, 200);
  }

  /* Welcher App-Bildschirm passt zu welchem Profil. Sprinter zeigt denselben
     plan-Screen wie sammler/ueberfordert, weil sein Feature (Lernplan mit
     Wiederholungslogik) ebenfalls der Studienplan ist. */
  const SCREEN = {
    koenner: 'test',
    sammler: 'plan',
    markierer: 'karte',
    ueberfordert: 'plan',
    einzel: 'tribes',
    sprinter: 'plan',
  };
  const mockSrc = (key) =>
    SCREEN[key] ? `/img/app/${fach}-${SCREEN[key]}.webp` : '/img/app/home.webp';

  function render() {
    const item = QUESTIONS[step];
    locked = false;
    el('q').textContent = item.q;
    el('count').textContent = `Frage ${step + 1} von ${QUESTIONS.length}`;
    el('mood').textContent = MOODS[step] || '';
    el('fill').style.width =
      Math.round(((step + 1) / QUESTIONS.length) * 100) + '%';
    el('mascot').innerHTML = MASCOT_FACES[step % MASCOT_FACES.length]();
    /* Der Ausweg steht bewusst zurueckgenommen unter den echten Optionen:
       erreichbar, aber nicht der bequemste Klick. */
    el('opts').innerHTML = item.a
      .map((o, i) => {
        const aus = o[2] === 'ausweg';
        return `<button class="lt-opt${aus ? ' lt-opt--aus' : ''}" type="button" onclick="pick(${i},this)">
             <span class="lt-opt__key">${aus ? '\u2013' : String.fromCharCode(65 + i)}</span>
             <span>${o[0]}</span>
           </button>`;
      })
      .join('');
    el('note').innerHTML = NOTES[step];
    el('back').classList.toggle('hide', step === 0);
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  }

  /* Kurze Verzoegerung nach dem Klick: die Auswahl wird sichtbar quittiert,
     bevor die naechste Frage kommt. Fuehlt sich deutlich besser an als ein
     sofortiger Sprung. */
  function pick(i, btn) {
    if (locked) return;
    locked = true;
    picks[step] = i;
    if (btn) btn.classList.add('picked');
    melden(false);
    const go = () => {
      if (step < QUESTIONS.length - 1) {
        step++;
        render();
      } else {
        finish();
      }
    };
    reduceMotion ? go() : setTimeout(go, 200);
  }

  function back() {
    if (step > 0) {
      step--;
      render();
    }
  }

  /* Zaehlt, wie oft "Nichts davon trifft auf mich zu" gewaehlt wurde. Das ist
     etwas anderes als eine niedrige Punktzahl: niedrige Punkte heissen "kein
     Bruchpunkt erkennbar", der Ausweg heisst "dieser Test beschreibt mich
     nicht". Beides verdient eine andere Antwort. */
  function auswege() {
    return picks.reduce(
      (n, choice, qi) => n + (QUESTIONS[qi].a[choice][2] === 'ausweg' ? 1 : 0),
      0
    );
  }

  function score() {
    const s = Object.fromEntries(ORDER.map((k) => [k, 0]));
    picks.forEach((choice, qi) => {
      const weights = QUESTIONS[qi].a[choice][1];
      for (const k in weights) s[k] += weights[k];
    });
    return s;
  }

  function finish() {
    const s = score();
    const lastPick = QUESTIONS[QUESTIONS.length - 1].a[picks[picks.length - 1]][1];
    const lastKey = Object.keys(lastPick)[0];
    let best = ORDER[0];
    ORDER.forEach((k) => {
      if (s[k] > s[best]) best = k;
    });
    /* Gleichstand entscheidet die Selbsteinschaetzung aus der letzten Frage.
       Wurde dort der Ausweg gewaehlt, ist lastKey undefined — dann bleibt es
       beim hoechsten Wert. */
    if (lastKey && s[lastKey] === s[best]) best = lastKey;

    /* Reihenfolge ist wichtig: Wer den Ausweg mehrfach gewaehlt hat, bekommt
       das Eingestaendnis, auch wenn nebenbei Punkte zusammengekommen sind. */
    const ausgewichen = auswege();
    if (ausgewichen >= 3) zustand = 'C';
    else if (s[best] <= 3) zustand = 'B';
    else zustand = 'A';

    lerntyp = best;
    melden(true);
    // Merker fuers kombinierte Meta-Ads-Conversion-Event: Ein anschliessender
    // Klick auf einen App-Store-Link (auf dieser oder jeder anderen Seite,
    // siehe BaseLayout.astro) zaehlt damit als "Quiz abgeschlossen + Klick".
    try {
      sessionStorage.setItem('octa-quiz-finished', '1');
    } catch (e) {}

    /* Attributprofil aus den Punkten ableiten, bevor das Ergebnis gebaut wird —
       Seite und Karte greifen anschliessend auf dasselbe Objekt zu. */
    attrAktuell = attrProfil(s);

    show('s-result');
    el('s-result').innerHTML = resultHTML(PROFILES[best], s, best);
    window.scrollTo({ top: 0, behavior: 'auto' });

    requestAnimationFrame(() => {
      const max = Math.max(...Object.values(s), 1);
      document.querySelectorAll('.lt-bar-fill').forEach((b) => {
        b.style.width = Math.round((+b.dataset.v / max) * 100) + '%';
      });
      /* Attributwerte sind bereits 0–100, also direkt als Breite nutzbar. */
      document.querySelectorAll('.lt-attr__fill').forEach((b) => {
        b.style.width = Math.max(6, Math.min(100, +b.dataset.v)) + '%';
      });
    });

    /* Die Karte wird gleich gezeichnet, damit im Teilen-Block eine echte
       Vorschau steht. Menschen teilen, was sie sehen koennen. */
    const zeichnen = () => { cardReady().catch(() => {}); };
    if (window.requestIdleCallback) requestIdleCallback(zeichnen, { timeout: 1500 });
    else setTimeout(zeichnen, 300);

    if (!reduceMotion) confetti();
    if (window.plausible) window.plausible('quiz_fertig', { props: { profil: best } });
  }

  /* Echte Rezensionen aus dem deutschen App Store. Nichts erfinden —
     Profile ohne passende Bewertung bleiben leer, dann traegt die
     Store-Gesamtbewertung. */
  const R = {
    timmi: {
      t: 'Zwei Tage vor der Klausur, Lernplan in zwei Minuten — am Ende 12 Punkte.',
      w: 'Timmi.bremmen · App Store',
    },
    fifi: {
      t: '„Simple, effective, and motivating“ — vor allem hilft es mir, organisiert zu bleiben.',
      w: 'So fifi · App Store',
    },
    dexter: {
      t: 'Endlich „one app that replaces many“: Karteikarten, Übersetzer und Sprachnotizen zusammen.',
      w: 'DexterBerlin36 · App Store',
    },
  };
  const REVIEWS = {
    koenner: [],
    sammler: [R.fifi, R.dexter],
    markierer: [],
    ueberfordert: [R.timmi],
    einzel: [],
    sprinter: [R.timmi],
  };


  /* ================================================================ *
   *  Sharekarte
   *  ----------------------------------------------------------------
   *  Je Lerntyp ein Attributprofil, ein Tipp und eine Ansprache fuers
   *  Teilen. Die Attributreihenfolge ist fix: Verstehen, Struktur,
   *  Dranbleiben, Abrufen, Behalten. "weak" ist der Index der einen
   *  schwachen Zeile — sie wird auf der Karte pink hervorgehoben und
   *  traegt damit die eigentliche Diagnose.
   * ================================================================ */
  const CARD = {
    koenner: {
      lines: ['Der', 'stille Könner'],
      tipp: 'Lies einen Abschnitt, klapp das Skript zu und erklär ihn laut, als säße jemand vor dir. Erst wenn der Satz ohne Stocken kommt, kannst du ihn.',
      share: 'Du kennst bestimmt jemanden, der in der Lerngruppe alles versteht und in der mündlichen Prüfung kein Wort rausbekommt.',
    },
    sammler: {
      lines: ['Der', 'Sammler'],
      tipp: 'Zieh einen Schlussstrich: Ab heute kommt kein neues Material mehr dazu. Was du hast, reicht. Jede weitere Datei verschiebt nur den Moment, an dem du anfängst.',
      share: 'Du kennst bestimmt jemanden, dessen Cloud-Ordner drei Versionen von jedem Skript enthält.',
    },
    markierer: {
      lines: ['Der', 'Markierer'],
      tipp: 'Deck zu, was du markiert hast, und sag es laut auf. Wenn du dabei stockst, kanntest du die Stelle nur wieder — gekonnt hast du sie nicht.',
      share: 'Du kennst bestimmt jemanden, dessen Skript nach zwei Wochen aussieht wie ein Farbkasten.',
    },
    ueberfordert: {
      lines: ['Der', 'Überforderte'],
      tipp: 'Fang bewusst beim schwersten Kapitel an, nicht beim ersten. Die Reihenfolge, die du suchst, entsteht beim Lernen — nicht davor.',
      share: 'Du kennst bestimmt jemanden, der seit drei Wochen bei Kapitel 2 hängt.',
    },
    einzel: {
      lines: ['Der', 'Einzelkämpfer'],
      tipp: 'Setz dir einen Termin mit einem Menschen, nicht mit dir selbst. Ein Vorsatz, den niemand kennt, überlebt die erste schlechte Woche nicht.',
      share: 'Du kennst bestimmt jemanden, der nie in der Lerngruppe auftaucht und trotzdem behauptet, es läuft.',
    },
    sprinter: {
      lines: ['Der', 'Sprinter'],
      tipp: 'Geh drei Tage nach der Klausur noch einmal zwanzig Minuten über den Stoff. Dieser eine Termin entscheidet, ob du ihn nächstes Semester wieder lernen musst.',
      share: 'Du kennst bestimmt jemanden, der drei Tage vorher anfängt und trotzdem besteht.',
    },
  };

  const TEST_URL = 'https://octastudy.com/tools/lerntyp-test/';

  /* Basisprofil je Lerntyp: die Werte, die ein reiner Vertreter haette.
     Reihenfolge fix — Verstehen, Struktur, Dranbleiben, Abrufen, Behalten. */
  const ATTR_NAMEN = ['Verstehen', 'Struktur', 'Dranbleiben', 'Abrufen', 'Behalten'];
  const ATTR_BASIS = {
    koenner:      [94, 76, 76, 18, 52],
    sammler:      [52, 18, 94, 52, 52],
    markierer:    [52, 52, 94, 18, 52],
    ueberfordert: [76, 18, 52, 52, 52],
    einzel:       [76, 52, 18, 52, 52],
    sprinter:     [76, 76, 34, 76, 18],
  };
  /* Wortstufen nach Rang im eigenen Profil statt nach absoluter Schwelle.
     So gibt es immer genau ein "gering" — zwei gleich beschriftete Zeilen in
     unterschiedlicher Farbe haben wie ein Fehler ausgesehen. */
  const ATTR_WORTE = ['sehr hoch', 'hoch', 'mittel', 'eher gering', 'gering'];

  /* Mischt aus den Punkten je Lerntyp ein individuelles Attributprofil.
     Quadratisch gewichtet: Der dominante Typ traegt das Profil, die uebrigen
     faerben es nur ein. Linear gewichtet zoege der Durchschnitt alles zur
     Mitte und jedes Ergebnis saehe gleich aus. */
  function attrProfil(punkte) {
    let gw = 0;
    const summe = [0, 0, 0, 0, 0];
    for (const t of ORDER) {
      const w = Math.pow(Math.max(0, punkte[t] || 0), 2);
      if (!w) continue;
      gw += w;
      ATTR_BASIS[t].forEach((v, i) => { summe[i] += v * w; });
    }
    const werte = gw ? summe.map((v) => Math.round(v / gw)) : ATTR_BASIS[ORDER[0]].slice();
    const rang = werte.map((v, i) => [v, i]).sort((a, b) => b[0] - a[0]).map((x) => x[1]);
    const zeilen = werte.map((v, i) => [ATTR_NAMEN[i], v, '']);
    rang.forEach((i, r) => { zeilen[i][2] = ATTR_WORTE[r]; });
    return { zeilen: zeilen, weak: rang[rang.length - 1] };
  }

  /* Profil des laufenden Durchgangs. Karte und Ergebnisseite lesen dasselbe
     Objekt, damit beide garantiert dieselben Werte zeigen. */
  let attrAktuell = null;

  const SHARE_SATZ =
    'Zwei verschiedene Profile ergänzen sich beim Abfragen besser als zwei gleiche — wer an einer anderen Stelle hängt als du, merkt genau die Lücken, die du selbst überliest.';

  /* Zeichenmasse der Karte. 1080x1920 ist das Story-Format von Instagram
     und WhatsApp; beide zeigen es ohne Beschnitt. */
  const CK = {
    W: 1080, H: 1920, PAD: 88, TOP: 86, BOT: 76,
    bg: '#15102a', accent: '#6c499e', accentSoft: '#c3aeea',
    white: '#ffffff', dim: '#aba5c4', line: '#2b2348',
    bar: '#b89be3', label: '#efecf8', muted: '#8e86ad',
    font: "'Plus Jakarta Sans', system-ui, sans-serif",
  };

  /* Buchstabenabstand von Hand gesetzt: ctx.letterSpacing kennt Safari erst
     ab 17.4, und ein grosser Teil der Zielgruppe ist aelter unterwegs. */
  function lcTracked(ctx, text, x, y, spacing) {
    let cx = x;
    for (const ch of text) {
      ctx.fillText(ch, cx, y);
      cx += ctx.measureText(ch).width + spacing;
    }
  }
  function lcWrap(ctx, text, maxW) {
    const words = String(text).split(' ');
    const lines = [];
    let line = '';
    for (const w of words) {
      const probe = line ? line + ' ' + w : w;
      if (ctx.measureText(probe).width > maxW && line) { lines.push(line); line = w; }
      else line = probe;
    }
    if (line) lines.push(line);
    return lines;
  }
  function lcRound(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  async function drawLerntypCard(canvas, key) {
    const c = CARD[key];
    if (!c) return;
    const ctx = canvas.getContext('2d');
    canvas.width = CK.W; canvas.height = CK.H;

    if (document.fonts && document.fonts.ready) { try { await document.fonts.ready; } catch (e) {} }

    /* Kein crossOrigin: Die Illustrationen liegen auf derselben Domain.
       Gesetztes crossOrigin wuerde den Export ohne CORS-Header brechen. */
    const img = await new Promise((res, rej) => {
      const i = new Image();
      i.onload = () => res(i);
      i.onerror = rej;
      i.src = '/img/lerntypen/' + key + '.webp';
    });

    ctx.fillStyle = CK.bg; ctx.fillRect(0, 0, CK.W, CK.H);
    ctx.fillStyle = CK.accent; ctx.fillRect(0, 0, CK.W, 9);

    const L = CK.PAD, R = CK.W - CK.PAD, IW = R - L;
    let y = CK.TOP;
    ctx.textBaseline = 'top';

    ctx.fillStyle = CK.accentSoft; ctx.font = '700 25px ' + CK.font;
    lcTracked(ctx, 'DEIN LERNTYP', L, y, 8.5);
    y += 51;

    ctx.fillStyle = CK.white; ctx.font = '800 118px ' + CK.font;
    for (const part of c.lines) { ctx.fillText(part, L, y); y += 110; }
    y += 12;

    ctx.fillStyle = CK.dim; ctx.font = '500 40px ' + CK.font;
    for (const ln of lcWrap(ctx, PROFILES[key].tagline ? '„' + PROFILES[key].tagline + '“' : '', IW)) {
      ctx.fillText(ln, L, y); y += 51;
    }

    const IH = 540;
    ctx.drawImage(img, (CK.W - img.width * (IH / img.height)) / 2, y + 14,
                  img.width * (IH / img.height), IH);
    y += 14 + IH + 22;

    const sec = (title) => {
      ctx.strokeStyle = CK.line; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(L, y + 1); ctx.lineTo(R, y + 1); ctx.stroke();
      y += 38;
      ctx.fillStyle = CK.accentSoft; ctx.font = '700 23px ' + CK.font;
      lcTracked(ctx, title, L, y, 6.5);
      y += 53;
    };

    sec('DEIN PROFIL');
    const LABW = 280, VALW = 196, GAP = 30;
    const prof = attrAktuell || attrProfil({ [key]: 1 });
    prof.zeilen.forEach(([name, pct, word], i) => {
      const weak = i === prof.weak;
      ctx.fillStyle = weak ? CK.accentSoft : CK.label;
      ctx.font = '700 31px ' + CK.font;
      ctx.fillText(name, L, y + 1);
      const tx = L + LABW, tw = IW - LABW - VALW - GAP;
      ctx.fillStyle = CK.line; lcRound(ctx, tx, y + 12, tw, 16, 8); ctx.fill();
      ctx.fillStyle = weak ? CK.accent : CK.bar;
      lcRound(ctx, tx, y + 12, Math.max(16, tw * pct / 100), 16, 8); ctx.fill();
      ctx.fillStyle = weak ? CK.accentSoft : CK.muted;
      ctx.font = '600 27px ' + CK.font;
      ctx.textAlign = 'right'; ctx.fillText(word, R, y + 5); ctx.textAlign = 'left';
      y += 64;
    });
    y += 14;

    sec('DEIN TIPP');
    ctx.fillStyle = CK.label; ctx.font = '600 38px ' + CK.font;
    for (const ln of lcWrap(ctx, c.tipp, IW)) { ctx.fillText(ln, L, y); y += 51; }

    const fy = CK.H - CK.BOT - 34;
    ctx.strokeStyle = CK.line; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(L, fy - 44); ctx.lineTo(R, fy - 44); ctx.stroke();
    ctx.font = '800 29px ' + CK.font; ctx.fillStyle = CK.white;
    ctx.fillText('octastudy.com', L, fy);
    ctx.font = '600 29px ' + CK.font; ctx.fillStyle = CK.muted;
    ctx.textAlign = 'right'; ctx.fillText('Welcher bist du?', R, fy); ctx.textAlign = 'left';
  }

  /* Blob wird einmal erzeugt und gemerkt — Teilen und Speichern nutzen denselben. */
  let cardBlob = null;
  async function cardReady() {
    const cv = document.getElementById('cardcanvas');
    if (!cv || !lerntyp) return null;
    if (!cv.dataset.drawn) {
      await drawLerntypCard(cv, lerntyp);
      cv.dataset.drawn = '1';
    }
    if (!cardBlob) cardBlob = await new Promise((r) => cv.toBlob(r, 'image/png'));
    return cardBlob;
  }

  async function saveCard() {
    const blob = await cardReady();
    if (!blob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'mein-lerntyp.png';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    if (window.plausible) window.plausible('karte_gespeichert', { props: { profil: lerntyp } });
  }

  async function shareCard() {
    const blob = await cardReady();
    if (!blob) return;
    const file = new File([blob], 'mein-lerntyp.png', { type: 'image/png' });
    /* Die Adresse steht bewusst IM Text und nicht im url-Feld von navigator.share:
       Sobald eine Datei mitgegeben wird, verwerfen mehrere Ziel-Apps das
       url-Feld. Im Text bleibt sie erhalten und wird von WhatsApp, iMessage
       und Signal automatisch anklickbar gemacht. */
    const text =
      'Ich bin ' + PROFILES[lerntyp].name + '. Welcher Lerntyp bist du? ' + TEST_URL;
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], text: text });
        if (window.plausible) window.plausible('karte_geteilt', { props: { profil: lerntyp } });
        return;
      } catch (e) {
        /* Abbruch durch den Nutzer ist kein Fehler — dann passiert nichts. */
        if (e && e.name === 'AbortError') return;
      }
    }
    saveCard();
  }

  /* Nach einem Klick auf den App-Store-Link wird der Merker gesetzt. Kommt der
     Nutzer danach in den Tab zurueck, zeigen wir die Teilen-Aufforderung ein
     zweites Mal. Ohne diesen Merker wuerde sie schon beim ersten App-Wechsel
     erscheinen, denn visibilitychange feuert auch beim Sperren des Geraets.
     Der Listener aendert ausschliesslich hidden — er rendert nichts neu und
     fasst damit den fachspezifischen Store-Link nicht an. */
  let storeKlick = false;
  function armShare() { storeKlick = true; }
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible' || !storeKlick) return;
    storeKlick = false;
    const n = document.getElementById('sharenudge');
    if (n) {
      n.hidden = false;
      n.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  function resultHTML(p, s, key) {
    const d = DETAIL[key];
    const c = CONCEPT[key];
    const cd = CARD[key];

    const bars = ORDER.map(
      (k) => `
      <div class="lt-bar-row ${k === key ? 'top-hit' : ''}">
        <div>
          <div class="lt-bar-name">${PROFILES[k].short}</div>
          <div class="lt-bar-track"><span class="lt-bar-fill" data-v="${s[k]}"></span></div>
        </div>
        <span class="lt-bar-val">${s[k]} Pkt.</span>
      </div>`
    ).join('');

    /* Zweitplatzierter: beantwortet "ich bin eher ein Mischtyp". Wird nur
       genannt, wenn der Abstand hoechstens einen Punkt betraegt — sonst ist
       es kein Mischbild, sondern ein klares Ergebnis. */
    const rang = ORDER.slice().sort((a, b) => s[b] - s[a]);
    const zweiter = rang[0] === key ? rang[1] : rang[0];
    const knapp = s[key] - s[zweiter] <= 1;

    /* Zustand B und C bekommen einen Vorspann, der das Ergebnis einordnet,
       bevor der Typ genannt wird. Der Typ bleibt in beiden Faellen stehen —
       als Tendenz, nicht als Befund. */
    const vorspann =
      zustand === 'C'
        ? `<div class="lt-vorspann lt-vorspann--aus">
             <h2>Dieser Test beschreibt dich nicht.</h2>
             <p>Du hast mehrfach angegeben, dass keine der Antworten auf dich
                passt. Dann hat der Test hier eine Lücke — nicht du.
                Wir zeigen dir trotzdem, wohin deine übrigen Antworten
                tendieren, aber nimm es als groben Hinweis, nicht als Ergebnis.</p>
             <p class="lt-vorspann__bitte">
               Was hätte bei dir stehen müssen?
               <a href="mailto:${CONFIG.kontaktMail}?subject=Lerntyp-Test:%20Antwort%20hat%20gefehlt">Schreib uns kurz</a>
               — wir bauen die Fragen danach um.
             </p>
           </div>`
        : zustand === 'B'
          ? `<div class="lt-vorspann">
               <h2>Bei dir gibt es keinen klaren Bruchpunkt.</h2>
               <p>Deine Antworten verteilen sich zu gleichmäßig, als dass eine
                  Stelle heraussticht. Das heißt im Zweifel: Dein Lernen läuft
                  weitgehend rund. Am ehesten tendierst du noch in diese Richtung —
                  als Hinweis, nicht als Diagnose.</p>
             </div>`
          : '';

    const prof = attrAktuell || attrProfil({ [key]: 1 });
    const attrBars = prof.zeilen
      .map(
        ([name, val, wort], i) => `
      <div class="lt-attr${i === prof.weak ? ' is-weak' : ''}">
        <span class="lt-attr__name">${name}</span>
        <span class="lt-attr__track"><span class="lt-attr__fill" data-v="${val}"></span></span>
        <span class="lt-attr__val">${wort}</span>
      </div>`
      )
      .join('');

    const reviews = REVIEWS[key] || [];
    const bewertungen = `
      <h3>Was andere sagen</h3>
      <div class="lt-rating">
        <span class="lt-rating-num">${STORE.schnitt}</span>
        <span>
          <span class="lt-stars">★★★★★</span>
          <span class="lt-rating-sub">${STORE.anzahl} Bewertungen im App&nbsp;Store · Stand ${STORE.stand}</span>
        </span>
      </div>
      ${reviews
        .map(
          (r) => `<div class="lt-rev">
            <div class="lt-stars">★★★★★</div>
            <p>${r.t}</p>
            <div class="lt-who">${r.w}</div>
          </div>`
        )
        .join('')}`;

    const cta = `
      <div class="lt-store">
        <p class="lt-store__note">
          <strong>Octa gibt es derzeit nur für iPhone und iPad.</strong>
          Eine <button class="lt-link" type="button" onclick="openWaitlist()">Android-Version</button>
          ist in Arbeit.
        </p>
        <div class="lt-codebox">
          <div class="lt-label">Dein Gratismonat als ${p.short}</div>
          <div class="lt-code" id="thecode">${p.code}</div>
          <button class="lt-copy" type="button" onclick="copyCode()">Code kopieren</button>
        </div>
        <a class="btn lt-btn-block" href="${storeLink(fach)}" target="_blank" rel="noopener"
           onclick="armShare();if(window.plausible)plausible('store_klick',{props:{code:'${p.code}',fach:fach}})">Octa im App Store laden</a>
      </div>

      <div class="lt-nudge" id="sharenudge" hidden>
        <p><strong>Eine Sache noch:</strong> Schick deine Karte der Person, an die du beim
           Lesen gedacht hast — und frag, was bei ihr rauskommt.</p>
        <div class="lt-share__btns">
          <button class="btn" type="button" onclick="shareCard()">Karte teilen</button>
        </div>
      </div>`;

    const mail = CONFIG.mailAktiv
      ? `<hr class="lt-divider">
         <div class="lt-befund" id="mailbox">
           <h3 style="margin-bottom:.4rem">Lieber erstmal ohne App?</h3>
           <p class="text-muted">Dann schicken wir dir deinen 7-Tage-Plan für ${p.name.toLowerCase()} — eine Aufgabe pro Tag, 20 bis 30 Minuten.</p>
           <label for="mail">E-Mail</label>
           <input id="mail" type="email" inputmode="email" autocomplete="email" placeholder="du@beispiel.de">
           <label for="exam">Nächste Prüfung (optional)</label>
           <input id="exam" type="date">
           <button class="btn btn--ghost lt-btn-block" type="button" onclick="sendMail('${p.code}')">Plan schicken</button>
           <p class="lt-fine">Nur für den Plan und Erinnerungen zu deiner Prüfung. Jederzeit abbestellbar.</p>
         </div>`
      : '';

    return `
      ${vorspann}

      <div class="lt-result-head">
        <img class="lt-result-img" src="/img/lerntypen/${key}.webp" srcset="/img/lerntypen/${key}@1x.webp 450w, /img/lerntypen/${key}.webp 900w" sizes="(max-width: 640px) 78vw, 340px" alt="Illustration: ${p.name}" />
        <span class="eyebrow">Dein Ergebnis</span>
        <h1 style="margin:.4rem 0 .5rem">${p.name}</h1>
        <p class="lt-tagline">${p.tagline}</p>
        ${
          /* In Zustand C haben wir oben schon gesagt, dass der Test nicht
             passt — dann waere dieser Satz nur noch Beschwichtigung. */
          zustand === 'C'
            ? ''
            : `<p class="lt-rahmen">
                 Das benennt eine Stelle in deinem Lernprozess — kein Urteil über dich.
               </p>`
        }
      </div>

      <div class="lt-befund">
        <span class="eyebrow" style="margin-bottom:1rem">Dein Profil</span>
        <div class="lt-attrs">${attrBars}</div>
        <p class="lt-attrs__note">
          Abgeleitet aus deinen acht Antworten. Die markierte Zeile ist die,
          an der es bei dir kippt — dort setzt auch
          <a class="lt-jump" href="#lt-tipp">dein Tipp</a> an.
        </p>
      </div>

      <div class="lt-block"><h3>Was du gut kannst</h3><p>${p.strength}</p></div>
      <div class="lt-block"><h3>Kennst du das?</h3><p class="lt-moment">${d.moment}</p></div>
      <div class="lt-block"><h3>Warum das passiert</h3><p>${d.why}</p></div>
      <div class="lt-block"><h3>Was dich das kostet</h3><p>${p.cost}</p></div>

      <details class="lt-eindeutig">
        <summary>Wie eindeutig war das?</summary>
        <p class="text-muted">
          Kein Mensch ist nur ein Typ. So haben sich deine Antworten auf die
          sechs Muster verteilt:
        </p>
        <div class="lt-bars">${bars}</div>
        ${
          knapp
            ? `<p class="lt-zweit">Bei dir liegt <strong>${PROFILES[zweiter].name}</strong>
                 fast gleichauf. Du bist eher ein Mischbild aus beiden — lies den
                 zweiten Teil ruhig mit.</p>`
            : ''
        }
      </details>

      <hr class="lt-divider">

      <div class="lt-block">
        <span class="eyebrow">Das Prinzip</span>
        <h3 style="margin:.75rem 0 .5rem">${c.titel}</h3>
        <p>${c.was}</p>
        <div class="lt-evidence-single">
          <strong>Warum das wirkt</strong>
          <p>${c.warum}</p>
        </div>
        <p><strong>Die Hürde im Alltag:</strong> ${c.huerde}</p>
      </div>

      <div class="lt-block lt-tipp" id="lt-tipp">
        <span class="eyebrow">Dein Tipp</span>
        <p class="lt-tipp__text">${cd.tipp}</p>
        <p class="lt-tipp__bruecke">
          Allein durchzuhalten ist dabei der schwere Teil — eine gute App nimmt
          ihn dir ab. <a class="lt-jump" href="#lt-umsetzung">So haben wir das gebaut</a>.
        </p>
      </div>

      <div class="lt-share">
        <h3 class="lt-share__frage">Wem schickst du das?</h3>
        <p class="lt-share__wen">${cd.share}</p>
        <details class="lt-share__mehr">
          <summary>Karte ansehen und schicken</summary>
          <div class="lt-share__inner">
            <div class="lt-share__preview">
              <canvas id="cardcanvas" class="lt-share__canvas" width="1080" height="1920"
                      role="img" aria-label="Deine Lerntyp-Karte zum Teilen"></canvas>
            </div>
            <div class="lt-share__text">
              <p><strong>Schick ihr deine Karte und frag, was bei ihr rauskommt.</strong>
                 ${SHARE_SATZ}</p>
              <div class="lt-share__btns">
                <button class="btn" type="button" onclick="shareCard()">Karte teilen</button>
                <button class="btn btn--ghost" type="button" onclick="saveCard()">Bild speichern</button>
              </div>
            </div>
          </div>
        </details>
      </div>

      <hr class="lt-divider">

      <div class="lt-block" id="lt-umsetzung">
        <span class="eyebrow">Die Umsetzung</span>
        <h3 style="margin:.75rem 0 .5rem">Genau dafür haben wir Octa gebaut</h3>
        <div class="lt-app">
          <div class="lt-app__text">
            <p class="lt-app__feature">${p.featureTitle}</p>
            <p>${d.why_octa}</p>
            <ol class="lt-steps">${d.how.map((x) => `<li>${x}</li>`).join('')}</ol>
          </div>
          <figure class="lt-phone">
            <img src="${mockSrc(key)}" sizes="(max-width: 720px) 60vw, 250px"
                 alt="Octa-App: ${MOCKUP_CAP[key]}" loading="lazy" />
            <figcaption>${MOCKUP_CAP[key]}</figcaption>
          </figure>
        </div>
      </div>

      <div class="lt-block">
        <h3>Was Octa sonst noch macht</h3>
        <ul class="lt-features">
          <li>
            <strong>Unterlagen hochladen — oder einfach das Thema eingeben</strong>
            Vorlesungs-PDF, Folien, abfotografierte Mitschrift oder Screenshot.
            Hast du gerade nichts zur Hand, reicht ein Stichwort: Octa recherchiert
            das Thema selbst und baut die Karten daraus.
          </li>
          <li>
            <strong>Karteikarten und Quizze automatisch</strong>
            Aus deinem eigenen Material, in Sekunden. Du schreibst keine
            einzige Karte selbst.
          </li>
          <li>
            <strong>„Test yourself“ auf jeder Karteikarte</strong>
            Antwort einsprechen statt tippen. Octa hört zu und antwortet
            gesprochen: was gefehlt hat, dazu eine Eselsbrücke und ein Tipp.
            Streng oder freundlich, je nach Einstellung.
          </li>
          <li>
            <strong>Lernplan bis zum Prüfungstermin</strong>
            Rechnet vom Prüfungstag rückwärts, schneidet den Stoff in
            Tagesportionen und bringt Wiederholungen zum richtigen Zeitpunkt
            zurück.
          </li>
          <li>
            <strong>Tribes</strong>
            Lerngruppen, in denen dein Fortschritt sichtbar ist — ohne dass du
            etwas melden musst.
          </li>
        </ul>
      </div>

      <div class="lt-block">${bewertungen}</div>

      <hr class="lt-divider">

      ${cta}
      ${mail}

      <hr class="lt-divider">

      <p class="lt-sharefoot">
        Noch nicht geteilt?
        <button class="lt-link" type="button" onclick="shareCard()">Karte an jemanden schicken</button>
      </p>

      <button class="lt-back" type="button" onclick="location.reload()">← Test noch einmal machen</button>`;
  }


  /* ------------------------------------------------- Android-Warteliste -- */

  /* Wortlaut der Einwilligung. Wird mitgespeichert, damit später belegbar ist,
     wozu genau der Nutzer zugestimmt hat. Bei jeder Textänderung mitziehen. */
  const WL_EINWILLIGUNG =
    'Ich möchte per E-Mail benachrichtigt werden, sobald die Android-Version von Octa verfügbar ist. Meine E-Mail-Adresse wird ausschließlich dafür genutzt und danach gelöscht.';

  function openWaitlist() {
    const body = el('wl-body');
    if (CONFIG.waitlistEndpoint) {
      body.innerHTML = `
        <label for="wl-mail">E-Mail</label>
        <input id="wl-mail" type="email" inputmode="email" autocomplete="email" placeholder="du@beispiel.de">
        <input id="wl-hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="lt-hp">
        <label class="lt-check" for="wl-consent">
          <input id="wl-consent" type="checkbox">
          <span>Ich möchte per E-Mail benachrichtigt werden, sobald die Android-Version von Octa verfügbar ist. Meine E-Mail-Adresse wird ausschließlich dafür genutzt und danach gelöscht. Die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> habe ich gelesen.</span>
        </label>
        <button class="btn" type="button" id="wl-send" onclick="sendWaitlist()">Auf die Warteliste</button>
        <p class="lt-msg hide" id="wl-msg"></p>
        <p class="lt-fine">Kein Newsletter, keine Werbung — genau eine Nachricht, wenn es so weit ist.</p>`;
    } else {
      body.innerHTML = `
        <p class="lt-fine" style="margin-bottom:1rem">Die Warteliste wird gerade eingerichtet. Bis dahin genügt eine kurze Mail — Betreff ist schon gesetzt.</p>
        <a class="btn" href="mailto:${CONFIG.kontaktMail}?subject=Android-Warteliste">Per E-Mail eintragen</a>`;
    }
    el('waitlist').classList.remove('hide');
    if (window.plausible) window.plausible('warteliste_geoeffnet');
  }

  function closeWaitlist() {
    el('waitlist').classList.add('hide');
  }

  function wlFehler(text) {
    const m = el('wl-msg');
    m.textContent = text;
    m.classList.remove('hide');
  }

  function sendWaitlist() {
    const feld = el('wl-mail');
    const consent = el('wl-consent');
    const knopf = el('wl-send');
    const mail = feld.value.trim();

    el('wl-msg').classList.add('hide');
    feld.style.borderColor = '';
    consent.closest('.lt-check').classList.remove('lt-check--miss');

    if (!/^\S+@\S+\.\S+$/.test(mail)) {
      feld.style.borderColor = '#E5177B';
      feld.focus();
      wlFehler('Diese E-Mail-Adresse sieht nicht vollständig aus.');
      return;
    }
    if (!consent.checked) {
      consent.closest('.lt-check').classList.add('lt-check--miss');
      consent.focus();
      wlFehler('Ohne dein Einverständnis dürfen wir die Adresse nicht speichern.');
      return;
    }

    knopf.disabled = true;
    knopf.textContent = 'Wird gesendet …';

    fetch(CONFIG.waitlistEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: mail,
        fach: fach || '',
        lerntyp: lerntyp || '',
        quelle: 'lerntyp-test',
        einwilligung: WL_EINWILLIGUNG,
        hp: el('wl-hp').value,
      }),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        if (!d || d.ok !== true) return Promise.reject('antwort');
        el('wl-body').innerHTML =
          '<div class="lt-done-note"><strong>Du stehst auf der Liste.</strong><br />Wir schreiben dir, sobald die Android-Version da ist — und sonst nie.</div>';
        if (window.plausible) window.plausible('warteliste_eingetragen');
      })
      .catch(() => {
        knopf.disabled = false;
        knopf.textContent = 'Noch einmal versuchen';
        wlFehler(
          'Das hat gerade nicht geklappt. Versuch es noch einmal oder schreib uns an ' +
            CONFIG.kontaktMail + '.'
        );
      });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeWaitlist();
  });
  document.getElementById('waitlist').addEventListener('click', (e) => {
    if (e.target.id === 'waitlist') closeWaitlist();
  });

  function copyCode() {
    const code = el('thecode').textContent;
    navigator.clipboard.writeText(code).then(() => {
      const b = document.querySelector('.lt-copy');
      b.textContent = 'Kopiert';
      setTimeout(() => (b.textContent = 'Code kopieren'), 1800);
    });
  }

  function sendMail(code) {
    const mail = el('mail').value.trim();
    if (!/^\S+@\S+\.\S+$/.test(mail)) {
      el('mail').style.borderColor = '#E5177B';
      el('mail').focus();
      return;
    }
    const payload = {
      email: mail,
      pruefung: el('exam').value || null,
      profil: code,
      plattform: isIOS ? 'ios' : 'andere',
      antworten: picks,
    };
    const done = () => {
      el('mailbox').innerHTML =
        '<div class="lt-done-note"><strong>Ist unterwegs.</strong><br />Dein Plan liegt gleich in deinem Postfach — schau notfalls im Spam nach.</div>';
    };
    if (!CONFIG.mailEndpoint) {
      console.warn('Kein mailEndpoint gesetzt. Payload:', payload);
      done();
      return;
    }
    fetch(CONFIG.mailEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(done)
      .catch(done);
  }

  /* Konfetti — kurz, dezent, in den Markenfarben. */
  function confetti() {
    const cv = el('confetti');
    const ctx = cv.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.style.display = 'block';
    cv.width = window.innerWidth * dpr;
    cv.height = window.innerHeight * dpr;
    ctx.scale(dpr, dpr);

    const colors = ['#E5177B', '#7C6BF0', '#F0B429', '#3E9BD8', '#17B98D'];
    const parts = Array.from({ length: 90 }, (_, i) => ({
      x: window.innerWidth * (0.15 + Math.sin(i * 12.9898) * 0.5 + 0.35),
      y: -20 - (i % 12) * 24,
      r: 4 + (i % 5),
      c: colors[i % colors.length],
      vy: 2.4 + (i % 7) * 0.35,
      vx: (((i * 37) % 100) / 100 - 0.5) * 2.2,
      rot: (i * 31) % 360,
      vr: (((i * 17) % 100) / 100 - 0.5) * 9,
    }));

    let frames = 0;
    (function tick() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      parts.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.045;
        p.rot += p.vr;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rot * Math.PI) / 180);
        ctx.fillStyle = p.c;
        ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 1.7);
        ctx.restore();
      });
      frames++;
      if (frames < 190) requestAnimationFrame(tick);
      else {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        cv.style.display = 'none';
      }
    })();
  }

  
</script>
