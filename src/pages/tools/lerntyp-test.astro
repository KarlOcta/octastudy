---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';

const FAQ = [
  {
    q: 'Wie lange dauert der Lerntyp-Test?',
    a: 'Acht Fragen, unter einer Minute. Am Ende bekommst du kein bloßes Etikett, sondern eine konkrete Einschätzung, an welcher Stelle deines Lernens am meisten Zeit verloren geht.',
  },
  {
    q: 'Ist der Lerntyp-Test wissenschaftlich?',
    a: 'Dieser Test fragt bewusst nicht nach Sinneskanälen (visuell, auditiv, haptisch, intellektuell) — die zugrunde liegende Theorie gilt als wissenschaftlich nicht belegt. Stattdessen fragt er dein tatsächliches Lernverhalten ab: wann du anfängst, ob du abrufst oder wiederliest, ob dir jemand auffällt, wenn du nicht dranbleibst. Warum, erklären wir ausführlich auf unserer Seite zu den Lerntypen.',
  },
  {
    q: 'Was mache ich mit dem Ergebnis?',
    a: 'Jedes der sechs Profile kommt mit einer konkreten Empfehlung, keiner allgemeinen Lerntipp-Liste — also mit dem, was bei genau diesem Muster am ehesten weiterhilft.',
  },
  {
    q: 'Muss ich mich registrieren?',
    a: 'Nein. Der Test läuft direkt im Browser, ohne Login und ohne dass etwas gespeichert wird.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/tools/lerntyp-test/#faq`,
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---

<BaseLayout
  title="Lerntyp-Test: Welcher Lerntyp bin ich? Kostenlos, 8 Fragen"
  description="Welcher Lerntyp bin ich? Kostenloser Test für Studierende: 8 Fragen, unter einer Minute, ohne Anmeldung — und du weißt, wo du beim Lernen Zeit verlierst."
  breadcrumbs={[
    { label: 'Tools', href: '/tools/' },
    { label: 'Lerntyp-Test', href: '/tools/lerntyp-test/' },
  ]}
  altHref="/en/tools/lerntyp-test/"
  ogImage="/img/og/lerntyp-test.jpg"
  wide
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <div class="wrap lt-page">
    <div class="lt-shell">
      <!-- ---------------------------------------------------- Intro -- -->
      <section id="s-intro" class="lt-screen on">
        <!-- 1 — Aufhänger: das gefühlte Problem, nicht das Produkt -->
        <div class="lt-hero">
          <span class="eyebrow">Kostenloser Lerntyp-Test für Studierende</span>
          <h1 class="lt-h1">
            Welcher Lerntyp bin ich?<br />Du lernst nicht zu wenig — du lernst{' '}
            <span class="hl">an der falschen Stelle</span>.
          </h1>
          <p class="lt-lede">
            Die meisten Studierenden scheitern nicht an fehlender Zeit oder
            Disziplin, sondern an einer einzigen Stelle im eigenen Lernprozess —
            und merken jahrelang nicht, an welcher. Dieser kostenlose Lerntyp-Test
            zeigt dir in acht Fragen, wo es bei dir tatsächlich hakt und was
            konkret dagegen hilft.
          </p>
          <button class="btn lt-btn-block" type="button" onclick="start()">
            Jetzt kostenlosen Test starten →
          </button>
          <p class="lt-zweck">
            Der Test sucht nicht, was du gut machst, sondern die eine Stelle, an
            der deine Lernzeit verloren geht. Das Ergebnis benennt deshalb ein
            Problem — nicht dein Können.
          </p>
          <ul class="lt-meta">
            <li>8 Fragen</li>
            <li>unter 60 Sekunden</li>
            <li>kein Login</li>
            <li>kostenlos</li>
          </ul>

          <div class="lt-cast" aria-hidden="true">
            <img src="/img/lerntypen/markierer@1x.webp" alt="" width="450" height="670" loading="eager" />
            <img src="/img/lerntypen/koenner@1x.webp" alt="" width="450" height="692" loading="eager" />
            <img src="/img/lerntypen/sprinter@1x.webp" alt="" width="450" height="658" loading="eager" />
          </div>
        </div>

        <!-- 2 — Wiedererkennung: Symptome zum Abhaken -->
        <section class="lt-band">
          <h2 class="rule">Kennst du das?</h2>
          <ul class="lt-symptoms">
            <li>Du liest ein Kapitel, verstehst alles — und zwei Tage später ist es weg.</li>
            <li>Du weißt die Antwort. Du bekommst sie mündlich nur nicht heraus.</li>
            <li>Du sitzt vor dem Stoff und verlierst zwanzig Minuten mit der Frage, womit du anfängst.</li>
            <li>Du lernst seit Wochen und hast trotzdem das Gefühl, nichts davon zu können.</li>
            <li>Du nimmst dir jeden Tag etwas vor — und niemandem fällt auf, wenn du es nicht tust.</li>
          </ul>
          <p class="lt-turn">
            Wenn dir davon etwas bekannt vorkommt: Dahinter steckt selten
            Faulheit. Dahinter steckt fast immer, dass du viel Energie an einer
            Stelle einsetzt, an der sie nichts bringt.
          </p>
        </section>

        <!-- 3 — Entlastung und Mechanismus -->
        <section class="lt-band">
          <h2 class="rule">Warum die üblichen Lerntipps bei dir nicht greifen</h2>
          <p>
            Du kennst die Einteilung in „visuelle“, „auditive“ und „haptische“
            Lerntypen. Sie klingt einleuchtend — und sie ist widerlegt. Studien
            finden keinen Beleg dafür, dass Material im bevorzugten Sinneskanal
            besser hängen bleibt. Wer danach lernt, optimiert die falsche
            Stellschraube.
          </p>
          <p>
            <strong>Es liegt also nicht an dir.</strong> Es liegt an
            Ratschlägen, die für alle gleichzeitig gelten sollen und deshalb für
            niemanden genau passen. Entscheidend ist nicht, wie du Informationen
            am liebsten aufnimmst, sondern <strong
              >an welcher Stelle deines Lernprozesses es abreißt</strong
            > — beim Sammeln, beim Verarbeiten, beim Abrufen oder beim Dranbleiben.
          </p>
          <p>
            Genau das misst dieser Test. Und weil der Bruchpunkt bei jedem woanders
            liegt, ist auch die Gegenmaßnahme bei jedem eine andere.
          </p>
          <div class="lt-cta-inline">
            <button class="btn" type="button" onclick="start()">
              Meinen Bruchpunkt finden →
            </button>
          </div>
        </section>

        <!-- 4 — Was der Test liefert -->
        <section class="lt-band">
          <h2 class="rule">Was der Test dir sagt</h2>
          <div class="lt-benefits">
            <div class="lt-benefit">
              <span class="lt-benefit__num">01</span>
              <h3>Deine Stärke</h3>
              <p>
                Womit du tatsächlich gut bist. Jedes der sechs Profile hat eine
                echte Fähigkeit im Kern — sie wird nur an der falschen Stelle
                eingesetzt.
              </p>
            </div>
            <div class="lt-benefit">
              <span class="lt-benefit__num">02</span>
              <h3>Dein Bruchpunkt</h3>
              <p>
                Die eine Stelle, an der deine Lernzeit verpufft — benannt,
                erklärt und mit dem, was sie dich in Prüfungen tatsächlich
                kostet.
              </p>
            </div>
            <div class="lt-benefit">
              <span class="lt-benefit__num">03</span>
              <h3>Dein nächster Schritt</h3>
              <p>
                Kein allgemeiner Lerntipp, sondern die Gegenmaßnahme, die zu
                deinem Profil passt — in drei Schritten, sofort umsetzbar.
              </p>
            </div>
          </div>
        </section>

        <!-- 5 — Typen-Vorschau: erzeugt die Frage „welcher bin ich?" -->
        <section class="lt-band">
          <h2 class="rule">Welcher Typ bist du?</h2>
          <p class="lt-band__intro">
            Sechs Profile, sechs verschiedene Stellen, an denen Lernzeit
            verloren geht. Keines davon ist ein Urteil über deine Intelligenz —
            jedes beschreibt eine Gewohnheit, die sich ändern lässt.
          </p>
          <p class="lt-band__hinweis">
            Du suchst die klassischen Lerntypen — visuell, auditiv, haptisch?
            Die verwenden wir bewusst nicht.
            <a href="/lerntypen/">Hier steht, warum dieses Modell der
            Überprüfung nicht standhält</a> und was die Forschung stattdessen
            empfiehlt.
          </p>

          <div class="lt-types">
            <article class="lt-type">
              <img src="/img/lerntypen/koenner@1x.webp" srcset="/img/lerntypen/koenner@1x.webp 450w, /img/lerntypen/koenner.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="692" alt="Illustration: Studierender sitzt im Schneidersitz und sucht nach Worten" loading="lazy" />
              <div>
                <h3>Der stille Könner</h3>
                <p class="lt-type__line">„Du kannst es. Bis du es sagen sollst.“</p>
                <p>
                  Versteht den Stoff wirklich und lernt nichts stumpf auswendig.
                  Trainiert dabei aber nur das Verstehen, nie das freie Abrufen —
                  und steht mündlich mit leerem Kopf da.
                </p>
              </div>
            </article>

            <article class="lt-type">
              <img src="/img/lerntypen/sammler@1x.webp" srcset="/img/lerntypen/sammler@1x.webp 450w, /img/lerntypen/sammler.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="595" alt="Illustration: Studentin zwischen hohen Papierstapeln mit weiteren Unterlagen im Arm" loading="lazy" />
              <div>
                <h3>Der Sammler</h3>
                <p class="lt-type__line">„Du hast alles. Gelernt hast du davon nichts.“</p>
                <p>
                  Hat jede Folie, jedes Skript, jede Mitschrift. Sammeln fühlt
                  sich wie Fortschritt an, schiebt die eigentliche
                  Auseinandersetzung aber immer weiter nach hinten.
                </p>
              </div>
            </article>

            <article class="lt-type">
              <img src="/img/lerntypen/markierer@1x.webp" srcset="/img/lerntypen/markierer@1x.webp 450w, /img/lerntypen/markierer.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="670" alt="Illustration: Studentin markiert eine bereits vollständig eingefärbte Buchseite" loading="lazy" />
              <div>
                <h3>Der Markierer</h3>
                <p class="lt-type__line">„Bunt heißt nicht gelernt.“</p>
                <p>
                  Fleißig und ausdauernd. Nur erzeugen Markieren und Wiederlesen
                  Vertrautheit statt Abrufbarkeit — die am besten belegte
                  Lernfalle überhaupt.
                </p>
              </div>
            </article>

            <article class="lt-type">
              <img src="/img/lerntypen/ueberfordert@1x.webp" srcset="/img/lerntypen/ueberfordert@1x.webp 450w, /img/lerntypen/ueberfordert.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="598" alt="Illustration: Studierender sitzt zwischen mehreren aufgeschlagenen Büchern und zögert" loading="lazy" />
              <div>
                <h3>Der Überforderte</h3>
                <p class="lt-type__line">„Nicht zu wenig Zeit. Zu viele Anfänge.“</p>
                <p>
                  Kein Disziplinproblem, ein Entscheidungsproblem. Solange der
                  ganze Stoff gleichzeitig dasteht, frisst die Frage nach dem
                  Anfang die Energie fürs Lernen.
                </p>
              </div>
            </article>

            <article class="lt-type">
              <img src="/img/lerntypen/einzel@1x.webp" srcset="/img/lerntypen/einzel@1x.webp 450w, /img/lerntypen/einzel.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="438" alt="Illustration: Studierender sitzt allein neben einem leeren Klappstuhl" loading="lazy" />
              <div>
                <h3>Der Einzelkämpfer</h3>
                <p class="lt-type__line">„Niemandem fällt auf, ob du es tust.“</p>
                <p>
                  Kann konzentriert allein arbeiten. Was fehlt, ist keine
                  Methode, sondern Verbindlichkeit — ein Vorsatz ohne Zeugen
                  kostet nichts, wenn er bricht.
                </p>
              </div>
            </article>

            <article class="lt-type">
              <img src="/img/lerntypen/sprinter@1x.webp" srcset="/img/lerntypen/sprinter@1x.webp 450w, /img/lerntypen/sprinter.webp 900w" sizes="(max-width: 640px) 40vw, 200px" width="450" height="658" alt="Illustration: Studentin rennt mit Büchern und Kaffeebecher, Blätter fliegen hinterher" loading="lazy" />
              <div>
                <h3>Der Sprinter</h3>
                <p class="lt-type__line">„Du schaffst es. Behalten tust du es nicht.“</p>
                <p>
                  Funktioniert unter Druck erstaunlich gut. Ohne Wiederholung
                  über mehrere Tage verfällt der Stoff aber — es rächt sich in
                  der nächsten Prüfung, die darauf aufbaut.
                </p>
              </div>
            </article>
          </div>

          <div class="lt-cta-inline">
            <button class="btn" type="button" onclick="start()">
              Herausfinden, welcher ich bin →
            </button>
          </div>
        </section>

        <!-- 6 — Belege statt Autorität -->
        <section class="lt-band">
          <h2 class="rule">Worauf der Test beruht</h2>
          <p>
            Die Auswertung stützt sich nicht auf eine Persönlichkeitstheorie,
            sondern auf Lernforschung. Zwei Befunde sind dabei zentral und in
            großen Übersichtsarbeiten quer über Fächer, Altersgruppen und
            Prüfungsformen bestätigt:
          </p>
          <ul class="lt-evidence">
            <li>
              <strong>Sich selbst abfragen schlägt Wiederlesen deutlich.</strong>
              Wiederlesen wirkt unmittelbar danach besser — nach einigen Tagen
              aber klar schlechter, und es macht sicherer, als man tatsächlich
              ist.
              <cite>Roediger &amp; Karpicke 2006 · Dunlosky u. a. 2013</cite>
            </li>
            <li>
              <strong>Verteiltes Lernen schlägt Lernen am Stück.</strong>
              Derselbe Stoff über mehrere Tage verteilt bleibt erheblich länger
              verfügbar als in einer einzigen langen Einheit.
              <cite>Dunlosky u. a. 2013</cite>
            </li>
          </ul>
          <p>
            Markieren und Wiederlesen — die beiden beliebtesten Lernmethoden
            überhaupt — landeten in derselben Übersichtsarbeit in der
            niedrigsten Wirksamkeitsklasse. Der Test prüft deshalb nicht deinen
            Geschmack, sondern deine Gewohnheiten.
          </p>
        </section>

        <!-- 7 — Abschluss-CTA -->
        <section class="lt-final">
          <h2>Acht Fragen. Danach weißt du es.</h2>
          <p>
            Kein Konto, keine E-Mail-Adresse, keine Weitergabe deiner Antworten.
            Der Test läuft vollständig in deinem Browser.
          </p>
          <button class="btn lt-btn-block" type="button" onclick="start()">
            Jetzt kostenlosen Test starten →
          </button>
          <p class="lt-fine">Dauer: unter einer Minute</p>
        </section>
      </section>


      <!-- ------------------------------------------- Studienfach (Schritt 0) -- -->
      <section id="s-fach" class="lt-screen">
        <div class="lt-top">
          <div class="lt-mascot" id="mascot-fach"></div>
          <div class="lt-progress">
            <div class="lt-progress__head">
              <span class="lt-count">Kurz vorab</span>
              <span class="lt-mood">Zählt nicht mit</span>
            </div>
            <div class="lt-track"><span class="lt-fill" style="width:6%"></span></div>
          </div>
        </div>
        <p class="lt-q">Was studierst du?</p>
        <p class="lt-fachhint">
          Damit die Beispiele zu deinem Fach passen. Eine Antwort, dann geht es
          mit den acht Fragen los.
        </p>
        <div class="lt-faecher" id="faecher"></div>
      </section>

      <!-- ----------------------------------------------------- Quiz -- -->
      <section id="s-quiz" class="lt-screen">
        <div class="lt-top">
          <div class="lt-mascot" id="mascot"></div>
          <div class="lt-progress">
            <div class="lt-progress__head">
              <span class="lt-count" id="count">Frage 1 von 8</span>
              <span class="lt-mood" id="mood"></span>
            </div>
            <div class="lt-track"><span class="lt-fill" id="fill"></span></div>
          </div>
        </div>

        <p class="lt-q" id="q"></p>
        <div class="lt-opts" id="opts"></div>
        <p class="lt-note" id="note"></p>
        <button class="lt-back hide" id="back" type="button" onclick="back()">
          ← zurück
        </button>
      </section>

      <!-- -------------------------------------------------- Ergebnis -- -->
      <section id="s-result" class="lt-screen lt-result"></section>
      <canvas id="confetti" class="lt-confetti" aria-hidden="true"></canvas>

    <!-- ------------------------------------------------- Android-Warteliste -- -->
    <div class="lt-overlay hide" id="waitlist" role="dialog" aria-modal="true" aria-labelledby="wl-title">
      <div class="lt-dialog">
        <button class="lt-dialog__x" type="button" onclick="closeWaitlist()" aria-label="Schließen">✕</button>
        <h3 id="wl-title">Android-Version</h3>
        <p>
          Octa gibt es aktuell nur für iPhone und iPad. Die Android-Fassung wird
          gebaut — trag dich ein und wir sagen dir Bescheid, sobald sie da ist.
        </p>
        <div id="wl-body"></div>
      </div>
    </div>

    </div>

    <section class="lt-faq-section">
      <h2 class="rule">Häufige Fragen</h2>
      <div class="faq">
        {
          FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="lt-faq-hint">
        Warum die vier klassischen Lerntypen wissenschaftlich umstritten
        sind und was stattdessen belegt ist:{' '}
        <a href="/lerntypen/">Lerntypen — was die Forschung wirklich sagt</a>.
      </p>
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* =====================================================================
     Lerntyp-Test — eigene Formsprache, aber auf den Design-Tokens der
     Seite aufgebaut. Bewusst `is:global`, weil ein Teil des Markups zur
     Laufzeit per innerHTML entsteht und Astros Scoping dort nicht greift.
     Alle Klassen sind mit `lt-` praefixiert.
     ===================================================================== */

  .lt-page {
    padding-block: 0 1rem;
  }

  .lt-shell {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
  }

  .lt-screen {
    display: none;
  }

  .lt-screen.on {
    display: block;
    animation: lt-rise 0.34s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  @keyframes lt-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hide {
    display: none !important;
  }

  /* ------------------------------------------------------------ Intro -- */

  .lt-h1 {
    margin: 0.35rem 0 0.9rem;
  }

  .lt-lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .lt-btn-block {
    width: 100%;
    max-width: 24rem;
    font-size: 1.05rem;
    padding-block: 1rem;
  }

  .lt-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    padding: 0;
    margin: 1.1rem 0 0;
    font-size: 0.9rem;
    color: var(--text-subtle);
  }

  .lt-meta li {
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .lt-meta li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  /* ------------------------------------------------------ Fortschritt -- */

  .lt-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .lt-mascot {
    flex: none;
    width: 60px;
    height: 60px;
  }

  .lt-mascot svg {
    width: 100%;
    height: 100%;
  }

  .lt-progress {
    flex: 1;
    min-width: 0;
  }

  .lt-progress__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .lt-count {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .lt-mood {
    font-size: 0.85rem;
    color: var(--text-subtle);
    text-align: right;
  }

  .lt-track {
    height: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .lt-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background-image: linear-gradient(90deg, var(--cta-from), var(--accent));
    transition: width 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* ------------------------------------------------------------ Frage -- */

  .lt-q {
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 1.85rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.012em;
    margin-bottom: 1.4rem;
    text-wrap: balance;
  }

  .lt-opts {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lt-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    text-align: left;
    cursor: pointer;
    background: var(--bg-card);
    color: var(--text);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1.45;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, background 0.15s ease,
      transform 0.12s ease, box-shadow 0.15s ease;
  }

  .lt-opt__key {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.8rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    transition: background 0.15s ease, color 0.15s ease,
      border-color 0.15s ease;
  }

  .lt-opt:hover {
    border-color: var(--accent);
    transform: translateX(3px);
    box-shadow: var(--shadow);
  }

  .lt-opt:hover .lt-opt__key {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: transparent;
  }

  .lt-opt.picked {
    border-color: transparent;
    background-image: linear-gradient(100deg, var(--cta-from), var(--cta-to));
    color: #fff;
    transform: scale(0.985);
  }

  .lt-opt.picked .lt-opt__key {
    background: rgb(255 255 255 / 0.22);
    color: #fff;
    border-color: transparent;
  }

  .lt-note {
    margin: 1.5rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .lt-note b {
    color: var(--text);
  }

  .lt-note cite {
    font-style: normal;
    color: var(--text-subtle);
  }

  .lt-back {
    background: none;
    border: 0;
    color: var(--text-subtle);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    padding: 0.7rem 0;
    margin-top: 0.5rem;
  }

  .lt-back:hover {
    color: var(--accent);
  }

  /* --------------------------------------------------------- Ergebnis -- */

  .lt-result-head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .lt-result-char {
    margin-inline: auto;
    width: 148px;
    height: 148px;
  }

  .lt-result-char svg {
    width: 100%;
    height: 100%;
    animation: lt-pop 0.55s cubic-bezier(0.2, 1.5, 0.4, 1) both;
  }

  @keyframes lt-pop {
    from {
      opacity: 0;
      transform: scale(0.4) rotate(-8deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lt-tagline {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--highlight);
    margin-bottom: 0;
  }

  .lt-befund {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 2.25rem;
    box-shadow: var(--shadow-sm);
  }

  .lt-bars {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .lt-bar-row {
    display: grid;
    grid-template-columns: 1fr 4.5rem;
    align-items: center;
    gap: 0.9rem;
  }

  .lt-bar-name {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .lt-bar-row.top-hit .lt-bar-name {
    color: var(--text);
    font-weight: 700;
  }

  .lt-bar-track {
    height: 8px;
    background: var(--bg-soft);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .lt-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
    transition: width 0.8s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .lt-bar-row.top-hit .lt-bar-fill {
    background-image: linear-gradient(90deg, var(--cta-from), var(--accent));
  }

  .lt-bar-val {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-subtle);
    text-align: right;
  }

  .lt-block {
    margin-bottom: 2rem;
  }

  .lt-block h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .lt-moment {
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--text);
    border-left: 3px solid var(--highlight);
    padding: 0.15rem 0 0.15rem 1.1rem;
    margin: 0;
  }

  .lt-steps {
    list-style: none;
    counter-reset: lt;
    margin: 1.1rem 0 0;
    padding: 0;
  }

  .lt-steps li {
    counter-increment: lt;
    position: relative;
    padding-left: 3rem;
    margin-bottom: 1.05rem;
    line-height: 1.55;
  }

  .lt-steps li::before {
    content: counter(lt);
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background-image: linear-gradient(135deg, var(--cta-from), var(--accent));
    color: #fff;
    font-size: 0.85rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .lt-divider {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  /* Demo-Platzhalter */
  .lt-demo {
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--text-subtle);
    font-size: 0.92rem;
    line-height: 1.55;
    background: var(--bg-soft);
  }

  .lt-demo strong {
    display: block;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .lt-demo video {
    width: 100%;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .lt-cap {
    font-size: 0.87rem;
    color: var(--text-subtle);
    text-align: center;
    margin: 0.6rem 0 0;
  }

  /* Bewertungen */
  .lt-rating {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    margin-bottom: 0.7rem;
  }

  .lt-rating-num {
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .lt-stars {
    color: var(--highlight);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    display: block;
  }

  .lt-rating-sub {
    display: block;
    font-size: 0.85rem;
    color: var(--text-subtle);
    margin-top: 0.15rem;
  }

  .lt-rev {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.15rem;
    margin-bottom: 0.7rem;
  }

  .lt-rev p {
    font-size: 0.98rem;
    margin: 0.4rem 0 0.5rem;
  }

  .lt-who {
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  /* Code-Box */
  .lt-codebox {
    border: 2px dashed var(--highlight);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-align: center;
    background: var(--accent-soft);
    margin-bottom: 1rem;
  }

  .lt-codebox .lt-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .lt-code {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.1rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--highlight);
    margin: 0.4rem 0 0.8rem;
    word-break: break-all;
  }

  .lt-copy {
    background: var(--bg-card);
    border: 1px solid var(--border-strong);
    color: var(--text-muted);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1.1rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .lt-copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .lt-fine {
    font-size: 0.85rem;
    color: var(--text-subtle);
    line-height: 1.55;
    margin-top: 0.9rem;
  }

  .lt-done-note {
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem;
    font-size: 0.98rem;
  }

  /* Konfetti */
  .lt-confetti {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 40;
    display: none;
  }

  /* SEO-Abschnitt */
  .lt-seo {
    max-width: var(--w-content);
    margin: 4.5rem auto 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .lt-seo h2 {
    margin-top: 0;
  }


  /* --------------------------------------------------- Landingpage -- */

  .lt-hero {
    padding-bottom: 1rem;
  }

  .lt-cast {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0;
    margin-top: 2.5rem;
  }

  .lt-cast img {
    width: 33%;
    max-width: 190px;
    height: auto;
  }

  .lt-cast img:nth-child(1) { transform: translateX(14%) scale(.86); }
  .lt-cast img:nth-child(3) { transform: translateX(-14%) scale(.86); }

  .lt-band {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .lt-band h2 {
    margin-top: 0;
  }

  .lt-band__intro {
    color: var(--text-muted);
    max-width: 44rem;
  }

  .lt-symptoms {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.6rem;
  }

  .lt-symptoms li {
    position: relative;
    margin-top: 0;
    padding: 0.85rem 1rem 0.85rem 3rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 1rem;
    line-height: 1.5;
    box-shadow: var(--shadow-sm);
  }

  .lt-symptoms li::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 5px;
    border: 2px solid var(--accent);
    background: var(--accent-soft);
  }

  .lt-turn {
    font-size: 1.1rem;
    line-height: 1.6;
    border-left: 3px solid var(--highlight);
    padding-left: 1.1rem;
    margin-bottom: 0;
  }

  .lt-cta-inline {
    margin-top: 1.75rem;
  }

  .lt-benefits {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .lt-benefit {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .lt-benefit__num {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.9rem;
  }

  .lt-benefit h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }

  .lt-benefit p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  /* Typen-Vorschau */
  .lt-band__hinweis {
    max-width: 62ch;
    margin: 0.9rem auto 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-subtle);
    text-align: center;
  }

  .lt-band__hinweis a {
    color: var(--accent);
    font-weight: 600;
  }

  .lt-types {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: 1.5rem;
  }

  .lt-type {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .lt-type img {
    flex: none;
    width: 6.5rem;
    height: auto;
    align-self: center;
  }

  .lt-type h3 {
    margin: 0 0 0.25rem;
    font-size: 1.08rem;
  }

  .lt-type__line {
    color: var(--highlight);
    font-weight: 700;
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
  }

  .lt-type p:last-child {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .lt-evidence {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: grid;
    gap: 0.9rem;
  }

  .lt-evidence li {
    margin-top: 0;
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.15rem;
    font-size: 0.97rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .lt-evidence strong {
    color: var(--text);
    display: block;
    margin-bottom: 0.2rem;
  }

  .lt-evidence cite {
    display: block;
    font-style: normal;
    font-size: 0.87rem;
    color: var(--text-subtle);
    margin-top: 0.35rem;
  }

  .lt-final {
    margin-top: 3.5rem;
    padding: 2.25rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .lt-final h2 {
    margin-top: 0;
  }

  .lt-final p {
    color: var(--text-muted);
    max-width: 34rem;
    margin-inline: auto;
  }

  .lt-final .btn {
    margin-inline: auto;
  }

  .lt-final .lt-fine {
    margin-top: 0.9rem;
  }

  /* Ergebnis-Illustration */
  .lt-result-img {
    display: block;
    width: min(340px, 78vw);
    height: auto;
    margin: 0 auto 0.75rem;
    animation: lt-pop 0.55s cubic-bezier(0.2, 1.5, 0.4, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-result-img { animation: none; }
  }

  @media (max-width: 560px) {
    .lt-type {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .lt-type img { width: 9rem; }
    .lt-cast { margin-top: 2rem; }
  }


  /* ---------------------------------------------- Ergebnis: App-Block -- */

  .lt-evidence-single {
    background: var(--bg-soft);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1rem 1.15rem;
    margin: 1.25rem 0;
  }

  .lt-evidence-single strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .lt-evidence-single p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .lt-app {
    display: grid;
    grid-template-columns: 1fr minmax(0, 250px);
    gap: 2rem;
    align-items: start;
  }

  .lt-app__feature {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  /* Telefon-Rahmen um den App-Screenshot */
  .lt-phone {
    margin: 0;
    position: relative;
  }

  .lt-phone img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 22px;
    border: 6px solid var(--brand-navy);
    box-shadow: var(--shadow-lg);
    background: #fff;
  }

  .lt-phone figcaption {
    margin-top: 0.7rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-subtle);
    text-align: center;
  }

  .lt-features {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .lt-features li {
    margin-top: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--text-muted);
    box-shadow: var(--shadow-sm);
  }

  .lt-features strong {
    display: block;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  /* Store-Block */
  .lt-store {
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-align: center;
  }

  .lt-store__note {
    font-size: 0.97rem;
    color: var(--text-muted);
    max-width: 32rem;
    margin-inline: auto;
  }

  .lt-store__note strong {
    color: var(--text);
  }

  .lt-store .lt-codebox {
    background: var(--bg-card);
    max-width: 26rem;
    margin-inline: auto;
  }

  .lt-store .btn {
    margin-inline: auto;
  }

  .lt-store .lt-fine {
    max-width: 30rem;
    margin-inline: auto;
  }

  @media (max-width: 720px) {
    .lt-app {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .lt-phone {
      max-width: 250px;
    }
  }


  /* Studienfach-Auswahl */
  .lt-fachhint {
    color: var(--text-muted);
    margin: -0.6rem 0 1.4rem;
    max-width: 34rem;
  }

  .lt-faecher {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .lt-fach {
    cursor: pointer;
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    font: inherit;
    font-size: 0.97rem;
    font-weight: 600;
    color: var(--text);
    text-align: left;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, transform 0.12s ease, background 0.15s ease;
  }

  .lt-fach:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .lt-fach.picked {
    border-color: transparent;
    background-image: linear-gradient(100deg, var(--cta-from), var(--cta-to));
    color: #fff;
  }

  /* Dialog */
  .lt-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgb(28 26 40 / 0.55);
    backdrop-filter: blur(3px);
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }

  .lt-dialog {
    position: relative;
    width: min(30rem, 100%);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    max-height: 90vh;
    overflow-y: auto;
  }

  .lt-dialog h3 {
    margin: 0 0 0.5rem;
  }

  .lt-dialog p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .lt-dialog__x {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 0;
    background: var(--bg-soft);
    color: var(--text-muted);
    font: inherit;
    cursor: pointer;
  }

  .lt-dialog label {
    display: block;
    font-size: 0.87rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 1rem 0 0.35rem;
  }

  .lt-dialog input {
    width: 100%;
    background: var(--bg-soft);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 0.9rem;
  }

  .lt-dialog input:focus {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .lt-dialog .btn {
    width: 100%;
    margin-top: 1.25rem;
  }

  /* Einwilligung */
  .lt-dialog label.lt-check {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin: 1.1rem 0 0;
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--text-subtle);
    cursor: pointer;
  }

  .lt-dialog label.lt-check input {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    margin-top: 0.15rem;
    padding: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .lt-dialog label.lt-check a {
    color: var(--accent);
    text-underline-offset: 2px;
  }

  .lt-check--miss span {
    color: var(--highlight);
  }

  /* Honigtopf gegen Bots — für Menschen unsichtbar, für Screenreader weg */
  .lt-dialog input.lt-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lt-msg {
    margin-top: 0.9rem;
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--highlight);
    font-weight: 600;
  }

  .lt-msg.hide {
    display: none;
  }

  /* Textlink im Store-Block */
  .lt-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-weight: 700;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .lt-link:hover {
    color: var(--accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .lt-screen.on,
    .lt-result-char svg {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .lt-top {
      gap: 0.75rem;
    }
    .lt-mascot {
      width: 48px;
      height: 48px;
    }
    .lt-mood {
      display: none;
    }
  }

  .lt-faq-section {
    max-width: 70ch;
    margin: 3rem auto 1rem;
  }

  .lt-faq-section .faq {
    margin-top: 1rem;
  }

  .lt-faq-section .faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }

  .lt-faq-section .faq summary {
    cursor: pointer;
    font-weight: 700;
