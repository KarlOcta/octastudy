---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OctaCtaBox from '../../../components/OctaCtaBox.astro';
import { OCTA, SITE } from '../../../site';

const HERO_SLIDES = [
  {
    src: '/img/mockups/app/andere-test.webp',
    alt: 'Octa-Karteikarte mit Button "Test yourself" — die Antwort wird laut gesprochen',
    caption: '"Test yourself" — du sprichst die Antwort laut ein',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-plan.webp',
    alt: 'Octa-Lernplan mit Lernpfad und Fortschritt bis zur Prüfung',
    caption: 'Ein Lernplan aus deinen Unterlagen, getaktet bis zur Prüfung',
    width: 752,
    height: 1559,
  },
];

const FAQ = [
  {
    q: 'Ist Quizlet kostenlos?',
    a: 'Im Kern ja — Karten erstellen, lernen und öffentliche Sets nutzen geht auch ohne Bezahlung. Für einzelne Zusatzfunktionen wie werbefreies Lernen, Offline-Zugriff oder erweiterte KI-Funktionen ist das kostenpflichtige Quizlet Plus nötig. Die aktuellen Preise findest du direkt im jeweiligen Store.',
  },
  {
    q: 'Was ist der Unterschied zwischen Quizlet und einer Alternative wie Octa?',
    a: 'Quizlet ist im Kern eine riesige Bibliothek fertiger, von anderen erstellter Karten-Sets plus mehrere Lernmodi zum Durchklicken. Octa erzeugt die Karten stattdessen aus deinem eigenen, aktuellen Material und verlangt beim Abfragen eine gesprochene Antwort statt eines Klicks — dafür fehlt die riesige Set-Bibliothek, die Quizlet mitbringt.',
  },
  {
    q: 'Sind die öffentlichen Quizlet-Sets zuverlässig?',
    a: 'Unterschiedlich. Jeder kann Sets veröffentlichen, entsprechend schwankt die Qualität — von sorgfältig erstellt bis fehlerhaft. Für Standardstoff (Vokabeln, Grundbegriffe) findet sich oft etwas Brauchbares, für sehr spezifischen Kursstoff eher nicht, weil kein fremdes Set exakt zu deiner Vorlesung passt.',
  },
  {
    q: 'Für wen bleibt Quizlet die bessere Wahl?',
    a: 'Für alle, die schnell auf bereits vorhandene Sets zu Standardthemen zugreifen wollen, ohne selbst etwas hochzuladen — etwa bei weit verbreitetem Schulstoff oder Sprachvokabeln, wo längst gute öffentliche Decks existieren.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}/blog/quizlet-alternative/#article`,
      headline: 'Quizlet-Alternative: Wenn du mehr willst als eine Karten-Bibliothek',
      description:
        'Quizlet im ehrlichen Vergleich: starke Set-Bibliothek und mehrere Lernmodi, aber keine echte Abfrage. Was eine Alternative anders macht.',
      inLanguage: 'de-DE',
      isAccessibleForFree: true,
      url: `${SITE.url}/blog/quizlet-alternative/`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/blog/quizlet-alternative/#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Quizlet-Alternative: Wenn du mehr willst als eine Karten-Bibliothek"
  description="Quizlet im ehrlichen Vergleich: starke Set-Bibliothek und mehrere Lernmodi, aber keine echte Abfrage. Was eine Alternative wie Octa anders macht."
  breadcrumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: 'Quizlet-Alternative', href: '/blog/quizlet-alternative/' },
  ]}
  wide
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <div class="wrap schema-page">
    <p class="eyebrow">Blog · App-Vergleich</p>
    <h1>Quizlet-Alternative: Wenn du mehr willst als eine Karten-Bibliothek</h1>
    <p class="lead intro">
      Quizlet ist eine der bekanntesten Lern-Apps überhaupt — mit gutem
      Grund: riesige Bibliothek an fertigen Sets, mehrere Lernmodi, im Kern
      kostenlos. Für viele reicht das völlig. Für andere fehlt genau der
      Teil, der beim Lernen den Unterschied macht: eine echte Abfrage statt
      Durchklicken.
    </p>

    <h2 class="rule rule--tight">Was Quizlet wirklich gut kann</h2>
    <p class="intro">
      Der größte Vorteil von Quizlet ist seine Größe: Für viele
      Standardthemen — Vokabeln, Grundbegriffe, Schulstoff — existieren
      bereits fertige, öffentliche Sets, die du direkt übernehmen kannst,
      ohne selbst etwas anzulegen. Dazu kommen mehrere Lernmodi
      (Karteikarten, Lernen, Test, Match), die Abwechslung ins reine
      Durchklicken bringen, und in den letzten Jahren zusätzliche
      KI-Funktionen, die eigene Notizen automatisch in Karten umwandeln.
      Die App ist auf Web, iOS und Android verfügbar und im Kern kostenlos
      nutzbar.
    </p>

    <h2 class="rule rule--tight">Wo Quizlet an seine Grenzen stößt</h2>
    <div class="grid">
      <div class="card">
        <span class="card__tag">Set-Qualität</span>
        <h3>Fremde Sets passen selten exakt</h3>
        <p>
          Öffentliche Sets sind von anderen Nutzern erstellt — bei
          Standardstoff oft brauchbar, bei spezifischem Vorlesungsinhalt
          passt aber selten ein fremdes Set exakt zu deinem Kurs, und die
          Qualität schwankt, weil jeder veröffentlichen kann.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Abfrage</span>
        <h3>Erkennen statt Erinnern</h3>
        <p>
          Die Lernmodi basieren größtenteils auf Wiedererkennen — Karte
          umdrehen, Multiple Choice, Tippen. Eine gesprochene, freie Antwort
          verlangt keiner der Modi; genau das unterscheidet aktives Abrufen
          aber von bloßem Wiedererkennen.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Lernplanung</span>
        <h3>Kein Fahrplan bis zur Prüfung</h3>
        <p>
          Quizlet organisiert Karten in Sets, aber es erstellt keinen
          Lernplan, der die Wiederholungen automatisch bis zu einem
          konkreten Prüfungstermin verteilt — die Planung bleibt bei dir.
        </p>
      </div>
    </div>

    <h2 class="rule rule--tight">Was eine Alternative wie Octa anders macht</h2>
    <p class="intro">
      Statt auf eine Bibliothek fremder Sets zu setzen, erzeugt {OCTA.name}{' '}
      Karten direkt aus deinem eigenen Material — {OCTA.pitch} Beim Abfragen
      reicht kein Klick: Der „Test yourself"-Button verlangt eine
      gesprochene Antwort, bevor die Lösung erscheint, und dazu einen
      Lernplan, der die Wiederholungen automatisch bis zu deiner Prüfung
      verteilt.
    </p>

    <div class="tabelle-wrap">
      <div class="tabelle">
        <div class="tabelle__head">
          <span>Merkmal</span>
          <span>Quizlet</span>
          <span>{OCTA.name}</span>
        </div>
        <div class="tabelle__row">
          <span>Kartenquelle</span>
          <span>Fremde Sets oder selbst getippt</span>
          <span>Automatisch aus eigenen Unterlagen</span>
        </div>
        <div class="tabelle__row">
          <span>Abfrage</span>
          <span>Klicken, Tippen, Multiple Choice</span>
          <span>Gesprochene Antwort + Feedback</span>
        </div>
        <div class="tabelle__row">
          <span>Lernplan bis zur Prüfung</span>
          <span>Nicht eingebaut</span>
          <span>Automatisch erstellt</span>
        </div>
        <div class="tabelle__row">
          <span>Erklärung bei Fehlern</span>
          <span>Keine</span>
          <span>KI-Tutor erklärt ausführlich</span>
        </div>
        <div class="tabelle__row">
          <span>Plattformen</span>
          <span>Web, iOS, Android</span>
          <span>iPhone &amp; iPad</span>
        </div>
      </div>
    </div>

    <p class="quellen-hint">
      Warum reines Wiedererkennen weniger bringt als aktives Abrufen: mehr
      dazu auf unserer Seite zu{' '}
      <a href="/lernmethoden/aktives-erinnern/">Active Recall</a>.
    </p>

    <OctaCtaBox
      id="quizlet-cta-slides"
      title="Aus deinem Material statt aus fremden Sets"
      storeLink={OCTA.appStoreUrl}
      primaryLabel={`${OCTA.name} im App Store ansehen`}
      secondaryLabel="Erst den Lerntyp-Test machen"
      secondaryHref="/tools/lerntyp-test/"
      slides={HERO_SLIDES}
      intervalMs={4200}
    >
      Lade dein erstes Kapitel hoch und sieh in wenigen Minuten, wie sich das
      anfühlt — kostenlos zum Ausprobieren, aktuell für iPhone und iPad.
    </OctaCtaBox>

    <h2 class="rule rule--tight">Häufige Fragen</h2>
    <div class="faq">
      {
        FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <h2 class="rule rule--tight">Quellen</h2>
    <p class="quellen-hint">
      Alle Angaben zu Quizlet stammen aus dessen offiziellem Angebot, Stand
      dieses Artikels — Preise und Funktionen können sich ändern.
      Mehr Vergleiche: <a href="/blog/">alle Blog-Artikel</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 70ch;
  }

  .tabelle-wrap {
    max-width: 70ch;
    overflow-x: auto;
    margin: 1rem 0 1.2rem;
  }

  .tabelle {
    min-width: 34rem;
    font-size: 0.92rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tabelle__head,
  .tabelle__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    padding: 0.6rem 1rem;
    gap: 0.5rem;
  }

  .tabelle__head {
    font-weight: 700;
    background: var(--bg-soft);
    color: var(--text-subtle);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tabelle__row:nth-child(odd) {
    background: var(--bg-soft);
  }

  .tabelle__row span:first-child {
    font-weight: 700;
  }

  .tabelle__row span:last-child {
    color: var(--accent);
    font-weight: 600;
  }

  .faq {
    max-width: 70ch;
    margin-bottom: 2rem;
  }

  .faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::before {
    content: '+';
    color: var(--accent);
    font-weight: 800;
    flex: none;
    line-height: 1.5;
  }

  .faq details[open] summary::before {
    content: '–';
  }

  .faq details p {
    margin: 0.6rem 0 0 1.4rem;
    color: var(--text-muted);
  }

  .quellen-hint {
    font-size: 0.9rem;
    color: var(--text-subtle);
    max-width: 70ch;
  }
</style>
