---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OctaCtaBox from '../../../components/OctaCtaBox.astro';
import { OCTA, SITE } from '../../../site';

const HERO_SLIDES = [
  {
    src: '/img/mockups/app/andere-karte.webp',
    alt: 'Octa-Karteikarte, generiert aus hochgeladenen Unterlagen',
    caption: 'Karten aus deinem eigenen Material, nicht von Hand getippt',
    width: 752,
    height: 1559,
  },
  {
    src: '/img/mockups/app/andere-test.webp',
    alt: 'Octa-Karteikarte mit Button "Test yourself" — die Antwort wird laut gesprochen',
    caption: '"Test yourself" — du sprichst die Antwort laut ein',
    width: 752,
    height: 1559,
  },
];

const FAQ = [
  {
    q: 'Ist Anki oder eine Alternative wie Octa die bessere Wahl?',
    a: 'Kommt auf den Aufwand an, den du investieren willst. Anki ist mächtig und kostenlos (außer auf iOS), verlangt aber, dass du deine Karten selbst schreibst und dir die Struktur — Decks, Tags, Lernplan — selbst baust. Eine App wie Octa nimmt dir das Kartenschreiben und die Planung ab, indem sie beides aus deinem eigenen Material erzeugt. Wer gerne tüftelt und Zeit investieren will, ist mit Anki gut bedient; wer die Zeit lieber ins eigentliche Lernen steckt, profitiert von der Automatisierung.',
  },
  {
    q: 'Kostet Anki etwas?',
    a: 'Anki selbst ist auf Windows, Mac, Linux und Android kostenlos und quelloffen. Nur die offizielle iOS-App AnkiMobile kostet eine einmalige App-Store-Gebühr (aktuell 24,99 US-Dollar) — eine ungewöhnliche Ausnahme, mit der der Entwickler die Weiterentwicklung finanziert.',
  },
  {
    q: 'Kann ich mit einer Alternative genauso gründlich lernen wie mit Anki?',
    a: 'Das Prinzip dahinter — sich aktiv erinnern statt passiv wiederzulesen, in wiederkehrenden Abständen — ist bei Anki und bei Octa dasselbe und wissenschaftlich gut belegt. Der Unterschied liegt nicht in der Lerntheorie, sondern darin, wie viel Vorarbeit du selbst leisten musst, bevor du überhaupt anfangen kannst zu lernen.',
  },
  {
    q: 'Für wen lohnt sich der Wechsel nicht?',
    a: 'Wer schon ein großes, gepflegtes Anki-Deck hat, mit dem Ökosystem aus Zusatzfunktionen (Add-ons) vertraut ist und den manuellen Aufwand nicht stört, hat mit Anki bereits eine ausgereifte Lösung — ein Wechsel würde dort eher stören als helfen.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${SITE.url}/blog/anki-alternative/#article`,
      headline: 'Anki-Alternative: Für wen sich der Wechsel lohnt (und für wen nicht)',
      description:
        'Was Anki wirklich gut kann, wo es an seine Grenzen stößt, und wann eine Alternative mit automatischer Kartenerstellung mehr Sinn ergibt.',
      inLanguage: 'de-DE',
      isAccessibleForFree: true,
      url: `${SITE.url}/blog/anki-alternative/`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/blog/anki-alternative/#faq`,
      mainEntity: FAQ.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title="Anki-Alternative: Für wen sich der Wechsel lohnt"
  description="Anki im ehrlichen Vergleich: was es gut kann, wo es an seine Grenzen stößt, und für wen eine Alternative mit automatischer Kartenerstellung mehr Sinn ergibt."
  breadcrumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: 'Anki-Alternative', href: '/blog/anki-alternative/' },
  ]}
  wide
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  <div class="wrap schema-page">
    <p class="eyebrow">Blog · App-Vergleich</p>
    <h1>Anki-Alternative: Für wen sich der Wechsel lohnt (und für wen nicht)</h1>
    <p class="lead intro">
      Anki hat unter Studierenden zurecht einen guten Ruf — der
      Wiederholungsalgorithmus ist erstklassig, die App ist kostenlos und
      Millionen Karten wurden damit gelernt. Trotzdem ist Anki nicht für
      jeden die richtige Wahl. Hier eine ehrliche Einordnung, was Anki
      wirklich gut kann und wo eine Alternative mehr abnimmt.
    </p>

    <h2 class="rule rule--tight">Was Anki wirklich gut kann</h2>
    <p class="intro">
      Der Kern von Anki ist sein Wiederholungsalgorithmus (SM2 bzw. neuer
      FSRS) — er berechnet für jede einzelne Karte, wann du sie kurz vor dem
      Vergessen erneut sehen solltest, und das macht er nachweislich gut.
      Anki ist auf Windows, Mac, Linux und über die kostenlose, quelloffene
      App AnkiDroid auch auf Android komplett kostenlos. Dazu kommt ein
      riesiges Ökosystem an Zusatzfunktionen (Add-ons) für so ziemlich jeden
      Spezialfall, von Bildbearbeitung bis Statistik-Dashboards.
    </p>

    <h2 class="rule rule--tight">Wo Anki an seine Grenzen stößt</h2>
    <div class="grid">
      <div class="card">
        <span class="card__tag">Kartenerstellung</span>
        <h3>Jede Karte selbst schreiben</h3>
        <p>
          Anki erzeugt keine Karten aus deinen Unterlagen — du tippst Frage
          und Antwort selbst ein, Karte für Karte. Bei zwanzig Karten pro
          Kapitel sind das schnell vierzig Minuten Schreibarbeit, bevor das
          eigentliche Lernen überhaupt beginnt.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Abfrage</span>
        <h3>Stille Selbsteinschätzung</h3>
        <p>
          Anki zeigt dir die Frage, du erinnerst dich im Kopf und schätzt
          danach selbst ein, ob du richtig lagst ("Again / Hard / Good /
          Easy"). Es gibt keine gesprochene Antwort und kein Feedback dazu,
          ob deine Antwort tatsächlich vollständig war.
        </p>
      </div>
      <div class="card">
        <span class="card__tag">Einstieg</span>
        <h3>Steile Lernkurve</h3>
        <p>
          Decks, Notiztypen, Tags, Einstellungen für das Scheduling — Anki
          ist mächtig, aber genau deshalb für Einsteiger nicht selbsterklärend.
          Die Oberfläche wirkt bis heute eher funktional als einladend.
        </p>
      </div>
    </div>

    <h2 class="rule rule--tight">Was eine Alternative wie Octa anders macht</h2>
    <p class="intro">
      Das Grundprinzip — sich aktiv erinnern statt passiv wiederzulesen, in
      wachsenden Abständen wiederholen — ist bei {OCTA.name} dasselbe wie bei
      Anki. Anders ist, wie viel davon automatisch passiert: {OCTA.pitch}{' '}
      Der „Test yourself"-Button verlangt eine gesprochene Antwort, bevor die
      Lösung erscheint, und ein KI-Tutor erklärt bei falschen oder halb
      richtigen Antworten ausführlich, warum die Lösung stimmt — statt sie
      dir nur stumm anzuzeigen.
    </p>

    <div class="tabelle-wrap">
      <div class="tabelle">
        <div class="tabelle__head">
          <span>Merkmal</span>
          <span>Anki</span>
          <span>{OCTA.name}</span>
        </div>
        <div class="tabelle__row">
          <span>Kartenerstellung</span>
          <span>Von Hand</span>
          <span>Automatisch aus Unterlagen</span>
        </div>
        <div class="tabelle__row">
          <span>Abfrage</span>
          <span>Stille Selbsteinschätzung</span>
          <span>Gesprochene Antwort + Feedback</span>
        </div>
        <div class="tabelle__row">
          <span>Erklärung bei Fehlern</span>
          <span>Keine</span>
          <span>KI-Tutor erklärt ausführlich</span>
        </div>
        <div class="tabelle__row">
          <span>Lernplan bis zur Prüfung</span>
          <span>Nicht eingebaut</span>
          <span>Automatisch erstellt</span>
        </div>
        <div class="tabelle__row">
          <span>Plattformen</span>
          <span>Win/Mac/Linux/Android kostenlos, iOS 24,99 $</span>
          <span>iPhone &amp; iPad</span>
        </div>
      </div>
    </div>

    <p class="quellen-hint">
      Zur Kartenerstellung von Hand: Auch Wiederlesen und Markieren fühlen
      sich produktiv an, gehören aber laut Forschung zu den am wenigsten
      wirksamen Methoden — mehr dazu auf unserer Seite zu{' '}
      <a href="/lernmethoden/aktives-erinnern/">Active Recall</a>.
    </p>

    <OctaCtaBox
      id="anki-cta-slides"
      title="Karten, die sich selbst schreiben"
      storeLink={OCTA.appStoreUrl}
      primaryLabel={`${OCTA.name} im App Store ansehen`}
      secondaryLabel="Erst den Lerntyp-Test machen"
      secondaryHref="/tools/lerntyp-test/"
      slides={HERO_SLIDES}
      intervalMs={4200}
    >
      Lade dein erstes Kapitel hoch und sieh in wenigen Minuten, wie sich das
      anfühlt — kostenlos zum Ausprobieren, aktuell für iPhone und iPad.
    </OctaCtaBox>

    <h2 class="rule rule--tight">Häufige Fragen</h2>
    <div class="faq">
      {
        FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <h2 class="rule rule--tight">Quellen</h2>
    <ul class="quellen">
      <li>
        Preisangabe AnkiMobile: offizieller{' '}
        <a href="https://apps.apple.com/app/id373493387" rel="noopener nofollow">
          App-Store-Eintrag von AnkiMobile Flashcards
        </a>.
      </li>
    </ul>
    <p class="quellen-hint">
      Alle Angaben zu Anki stammen aus dessen offiziellem Store-Eintrag,
      Stand dieses Artikels — Preise und Funktionen können sich ändern.
      Mehr Vergleiche: <a href="/blog/">alle Blog-Artikel</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 70ch;
  }

  .tabelle-wrap {
    max-width: 70ch;
    overflow-x: auto;
    margin: 1rem 0 1.2rem;
  }

  .tabelle {
    min-width: 34rem;
    font-size: 0.92rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tabelle__head,
  .tabelle__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    padding: 0.6rem 1rem;
    gap: 0.5rem;
  }

  .tabelle__head {
    font-weight: 700;
    background: var(--bg-soft);
    color: var(--text-subtle);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tabelle__row:nth-child(odd) {
    background: var(--bg-soft);
  }

  .tabelle__row span:first-child {
    font-weight: 700;
  }

  .tabelle__row span:last-child {
    color: var(--accent);
    font-weight: 600;
  }

  .faq {
    max-width: 70ch;
    margin-bottom: 2rem;
  }

  .faq details {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::before {
    content: '+';
    color: var(--accent);
    font-weight: 800;
    flex: none;
    line-height: 1.5;
  }

  .faq details[open] summary::before {
    content: '–';
  }

  .faq details p {
    margin: 0.6rem 0 0 1.4rem;
    color: var(--text-muted);
  }

  .quellen {
    max-width: 70ch;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 0.8rem;
  }

  .quellen li {
    margin-bottom: 0.8rem;
  }

  .quellen-hint {
    font-size: 0.9rem;
    color: var(--text-subtle);
    max-width: 70ch;
  }
</style>
