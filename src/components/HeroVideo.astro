---
/**
 * Bewegter Hintergrund im Hero — als Zusatzschicht, nicht als Fundament.
 *
 * Darunter liegt weiterhin der CSS-Lichtschein. Das Video legt sich nur
 * darueber, wenn alles dafuer spricht. Scheitert irgendetwas — kein
 * JavaScript, ruhige Oberflaechen eingestellt, Datensparmodus, alte
 * Browser, Video blockiert — bleibt der Lichtschein stehen und niemand
 * merkt, dass etwas gefehlt hat.
 *
 * Deshalb steht im HTML auch kein <source>: Die Quellen setzt erst das
 * Skript. Ohne diesen Schritt laedt der Browser nichts, das Video kann also
 * weder den LCP verzoegern noch auf einer Mobilverbindung Daten kosten.
 *
 * Zwei Fassungen, hell und dunkel — eine einzige Datei kann nicht auf
 * beiden Untergruenden funktionieren, weil Video keine Transparenz traegt.
 * Geladen wird immer nur die passende.
 */
---

<div class="hv" aria-hidden="true">
  <video
    class="hv__film"
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="none"
    tabindex="-1"></video>
</div>

<script>
  (() => {
    const wurzel = document.querySelector<HTMLElement>('.hv');
    const film = wurzel?.querySelector<HTMLVideoElement>('.hv__film');
    if (!wurzel || !film) return;

    /* Alle Gruende, es bleiben zu lassen. */
    const ruhig = !window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const sparsam = (navigator as any).connection?.saveData === true;
    const langsam = /2g/.test((navigator as any).connection?.effectiveType || '');
    if (ruhig || sparsam || langsam) return;
    if (!film.canPlayType('video/mp4') && !film.canPlayType('video/webm')) return;

    let gesetzt = '';

    const anwerfen = () => {
      const dunkel = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const modus = dunkel ? 'dunkel' : 'hell';
      if (modus === gesetzt) return;
      gesetzt = modus;

      film.innerHTML =
        `<source src="/video/hero-${modus}.webm" type="video/webm">` +
        `<source src="/video/hero-${modus}.mp4" type="video/mp4">`;
      film.poster = `/video/poster-${modus}.jpg`;
      film.load();

      /* Erst einblenden, wenn wirklich Bilder kommen — sonst blitzt beim
         Umschalten kurz das Standbild des alten Modus auf. */
      film.addEventListener(
        'playing',
        () => wurzel.setAttribute('data-laeuft', 'ja'),
        { once: true }
      );
      /* play() kann abgelehnt werden (Energiesparmodus, Richtlinien des
         Browsers). Dann passiert einfach nichts weiter. */
      film.play().catch(() => {});
    };

    /* Nach dem Laden der Seite, damit nichts mit dem ersten Bildaufbau
       konkurriert. requestIdleCallback kennt nicht jeder Browser. */
    const spaeter = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 600));
    if (document.readyState === 'complete') spaeter(anwerfen);
    else window.addEventListener('load', () => spaeter(anwerfen), { once: true });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      wurzel.removeAttribute('data-laeuft');
      anwerfen();
    });
  })();
</script>

<style>
  .hv {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hv[data-laeuft='ja'] {
    opacity: 1;
  }

  .hv__film {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Der Verlauf nach unten blendet das Video in die Seitenfarbe aus, damit
     es nicht an der Hero-Kante abgeschnitten wirkt. */
  .hv::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      180deg,
      transparent 55%,
      var(--bg) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .hv {
      display: none;
    }
  }

  @media print {
    .hv {
      display: none;
    }
  }
</style>
