---
/**
 * Rotierende App-Store-Bewertungen.
 *
 * Gleiche Machart wie MockupSlideshow.astro (Crossfade, Punkte darunter,
 * klickbar) — nur für Text statt Bilder. Eine einzelne Bewertung wirkt wie
 * ein herausgepickter Einzelfall; mehrere nacheinander zeigen, dass es
 * mehr als eine gibt, ohne die Seite mit einer langen Liste zu füllen.
 *
 * Gezeigt wird die Bewertung so, wie sie im App Store steht: Sterne, Titel,
 * Datum, Verfasser und der vollständige Wortlaut. Der Wortlaut wird NICHT
 * gekürzt, geglättet oder übersetzt — auch englische Bewertungen bleiben
 * englisch. Eine Rezension umzuschreiben wäre eine Falschdarstellung, und
 * in Deutschland ist das wettbewerbsrechtlich angreifbar.
 *
 * Hier stehen ausschließlich echte Bewertungen. Nichts wird erfunden.
 */
export interface Zitat {
  /** Überschrift der Bewertung im App Store. */
  titel: string;
  /** Wortlaut, unverändert. */
  text: string;
  /** Verfassername wie im App Store. */
  wer: string;
  /** Datum wie im App Store, z. B. "24. Feb. 2026". */
  datum: string;
  /** Sterne, 1–5. Praktisch immer 5 — steht trotzdem in den Daten, damit
   *  niemand versehentlich eine Vier-Sterne-Bewertung als fünf ausweist. */
  sterne?: number;
}

export interface Props {
  zitate: Zitat[];
  /** Eindeutige ID, falls mehrere Slideshows auf derselben Seite laufen. */
  id: string;
  intervalMs?: number;
}

const { zitate, id, intervalMs = 6500 } = Astro.props;
---

<div class="zs" id={id} data-interval={intervalMs}>
  <div class="zs__frame">
    {
      zitate.map((z, i) => (
        <blockquote class="zs__item" data-active={i === 0 ? 'true' : 'false'}>
          <div
            class="zs__sterne"
            role="img"
            aria-label={`${z.sterne ?? 5} von 5 Sternen`}
          >
            {'★'.repeat(z.sterne ?? 5)}
            <span class="zs__leer">{'★'.repeat(5 - (z.sterne ?? 5))}</span>
          </div>
          <p class="zs__titel">{z.titel}</p>
          <p class="zs__text">{z.text}</p>
          <cite class="zs__wer">
            {z.wer} · {z.datum} · App&nbsp;Store
          </cite>
        </blockquote>
      ))
    }
  </div>
  {
    zitate.length > 1 && (
      <div class="zs__dots" role="tablist" aria-label="Bewertungen">
        {zitate.map((_, i) => (
          <button
            type="button"
            class="zs__dot"
            data-index={i}
            aria-current={i === 0 ? 'true' : undefined}
            aria-label={`Bewertung ${i + 1} von ${zitate.length}`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  function initZitate(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.zs__item'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.zs__dot'));
    if (items.length < 2) return;

    let active = 0;
    const interval = Number(root.dataset.interval) || 6500;

    const show = (i: number) => {
      items[active].dataset.active = 'false';
      dots[active].removeAttribute('aria-current');
      active = i;
      items[active].dataset.active = 'true';
      dots[active].setAttribute('aria-current', 'true');
    };

    let timer = setInterval(() => show((active + 1) % items.length), interval);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        clearInterval(timer);
        show(Number(dot.dataset.index));
        timer = setInterval(() => show((active + 1) % items.length), interval);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.zs').forEach(initZitate);
</script>

<style>
  /* Alle Bewertungen liegen in derselben Rasterzelle übereinander. Dadurch
     ist der Block immer so hoch wie die längste Bewertung — auf jeder
     Breite, ohne feste Zahl. Eine gesetzte Mindesthöhe wäre hier falsch:
     gemessen braucht dieselbe Bewertung bei 1280px 14rem und bei 320px
     32rem, jeder feste Wert wäre also mal zu klein und mal zu groß.
     visibility statt display haelt den Platz frei und nimmt die inaktiven
     Bewertungen trotzdem aus der Vorlesereihenfolge. */
  .zs__frame {
    display: grid;
  }

  .zs__item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    margin: 0;
    padding-left: 1.1rem;
    border-left: 3px solid var(--brand-pink);
    transition: opacity 0.45s ease;
  }

  .zs__item[data-active='true'] {
    opacity: 1;
    visibility: visible;
  }

  .zs__sterne {
    color: var(--brand-pink);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .zs__leer {
    color: var(--border-strong, #d8d6e8);
  }

  .zs__titel {
    margin: 0.55rem 0 0.3rem;
    font-weight: 800;
    font-size: 1.02rem;
    color: var(--text);
  }

  .zs__text {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .zs__wer {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--text-subtle);
  }

  .zs__dots {
    display: flex;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .zs__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--border-strong, #d8d6e8);
    cursor: pointer;
  }

  .zs__dot[aria-current='true'] {
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .zs__item {
      transition: none;
    }
  }
</style>
