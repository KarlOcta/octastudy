---
/**
 * Die drei Illustrationen aus dem Lerntyp-Test als wiederverwendbarer Block.
 * Wird auf der Startseite, in der Tool-Übersicht und auf der Lerntypen-Seite
 * eingesetzt, damit der Test überall dasselbe Gesicht hat.
 *
 * Rein dekorativ — deshalb aria-hidden und leere alt-Attribute. Wer die Seite
 * vorgelesen bekommt, verpasst nichts: Der Text daneben sagt dasselbe.
 */
export interface Props {
  /** Zusätzliche Klassen für den Abstand am Einsatzort */
  class?: string;
  /** Bilder früh laden (nur sinnvoll, wenn der Block oben auf der Seite steht) */
  eager?: boolean;
  /** Kleine Beschriftung unter jeder Figur, damit klar ist, was man sieht */
  labels?: boolean;
}

const { class: extra = '', eager = false, labels = false } = Astro.props;
const laden = eager ? 'eager' : 'lazy';

const figuren = [
  { src: '/img/lerntypen/markierer@1x.webp', w: 450, h: 670, name: 'Der Markierer' },
  { src: '/img/lerntypen/koenner@1x.webp', w: 450, h: 692, name: 'Der Könner' },
  { src: '/img/lerntypen/sprinter@1x.webp', w: 450, h: 658, name: 'Der Sprinter' },
];
---

<div class={`trio ${extra} ${labels ? 'trio--labels' : ''}`} aria-hidden={labels ? undefined : 'true'}>
  {
    figuren.map((f) => (
      <div class="trio__fig">
        <img
          src={f.src}
          alt={labels ? f.name : ''}
          width={f.w}
          height={f.h}
          loading={laden}
          decoding="async"
        />
        {labels && <span class="trio__label">{f.name}</span>}
      </div>
    ))
  }
</div>

<style>
  .trio {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0;
  }

  .trio__fig {
    width: 33%;
    max-width: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .trio__fig img {
    width: 100%;
    height: auto;
  }

  .trio__label {
    margin-top: 0.4em;
    font-size: 0.8rem;
    color: var(--muted, #6b7280);
    text-align: center;
  }

  /* Die äußeren beiden etwas kleiner und nach innen gerückt — das ergibt die
     Staffelung, ohne dass die Figuren einander überdecken. */
  .trio__fig:nth-child(1) {
    transform: translateX(14%) scale(0.86);
  }

  .trio__fig:nth-child(3) {
    transform: translateX(-14%) scale(0.86);
  }

  .trio--labels .trio__fig:nth-child(1),
  .trio--labels .trio__fig:nth-child(3) {
    transform: none;
  }

  @media (max-width: 480px) {
    .trio__fig {
      max-width: 130px;
    }
  }
</style>
