---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, META_PIXEL_ID } from '../site';
import '../styles/global.css';

export type Crumb = { label: string; href: string };

export interface Props {
  /** Seitentitel ohne Marken-Suffix */
  title: string;
  /** Meta-Description, 140–160 Zeichen */
  description: string;
  /** Breadcrumb-Pfad ohne Startseite — die wird automatisch vorangestellt */
  breadcrumbs?: Crumb[];
  /** Von der Indexierung ausnehmen (z. B. Impressum, Datenschutz, 404) */
  noindex?: boolean;
  /** Breite Inhaltsspalte statt Lesebreite */
  wide?: boolean;
  /** Sprache dieser Seite. Deutsch liegt auf der Root-Domain, Englisch unter /en/. */
  lang?: 'de' | 'en';
  /** Pfad der Sprachversion dieser Seite (z. B. '/en/tools/lerntyp-test/' von
   * der deutschen Seite aus, oder umgekehrt) — erzeugt die hreflang-Paarung.
   * Weglassen, wenn es (noch) keine Übersetzung dieser Seite gibt. */
  altHref?: string;
}

const {
  title,
  description,
  breadcrumbs = [],
  noindex = false,
  wide = false,
  lang = 'de',
  altHref,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const altCanonical = altHref
  ? new URL(altHref, Astro.site ?? SITE.url).href
  : undefined;
const fullTitle =
  Astro.url.pathname === '/'
    ? `${SITE.name} — ${SITE.tagline}`
    : `${title} | ${SITE.name}`;
const ogLocale = lang === 'en' ? 'en_US' : 'de_DE';
const skipLinkLabel = lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen';
const homeLabel = lang === 'en' ? 'Home' : 'Startseite';
const breadcrumbLabel = lang === 'en' ? 'Breadcrumb' : 'Brotkrumen-Navigation';

const containerClass = wide ? 'wrap' : 'prose';

// --- Schema.org --------------------------------------------------------
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    inLanguage: lang === 'en' ? 'en-US' : 'de-DE',
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [{ label: 'Startseite', href: '/' }, ...breadcrumbs].map(
      (crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        item: new URL(crumb.href, SITE.url).href,
      })
    ),
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5B4BD0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    {altCanonical && (
      <>
        <link rel="alternate" hreflang={lang === 'en' ? 'de' : 'en'} href={altCanonical} />
        <link rel="alternate" hreflang={lang} href={canonical} />
        <link rel="alternate" hreflang="x-default" href={lang === 'en' ? altCanonical : canonical} />
      </>
    )}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <script define:vars={{ metaPixelId: META_PIXEL_ID }}>
      /**
       * Microsoft Clarity wird nie bedingungslos geladen — nur ueber diese
       * Funktion. Sie ist absichtlich idempotent (laedt das Script hoechstens
       * einmal), weil sie inzwischen aus mehreren Pfaden heraus aufgerufen
       * werden kann (siehe octaConsentReady unten und CookieConsent.astro).
       * Siehe datenschutz.astro Ziffer 8 fuer die zugehoerige Erklaerung.
       */
      window.octaLoadClarity = function () {
        if (window.octaClarityLoaded) return;
        window.octaClarityLoaded = true;
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "yaenpnemfj");
      };

      /**
       * Meta Pixel (Werbemessung), genauso idempotent und ueber dieselbe
       * Einwilligung gesteuert wie Clarity — siehe octaLoadMarketingTools
       * unten, die beide zusammen laedt. Eigenes Dataset nur fuer
       * octastudy.com (Pixel-ID aus site.ts), getrennt von den Datasets der
       * App und der alten Landingpage. Siehe datenschutz.astro Ziffer 8.
       */
      window.octaLoadMetaPixel = function () {
        if (window.octaMetaPixelLoaded) return;
        window.octaMetaPixelLoaded = true;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixelId);
        fbq('track', 'PageView');
      };

      /** Beide optionalen Tools zusammen — eine Einwilligung, ein Aufruf. */
      window.octaLoadMarketingTools = function () {
        window.octaLoadClarity();
        window.octaLoadMetaPixel();
      };

      /**
       * Klaert VOR dem ersten Render von CookieConsent.astro, ob fuer diese/n
       * Besucher:in ueberhaupt eine Einwilligung noetig ist:
       *  1. Liegt schon eine explizite Entscheidung im localStorage vor
       *     ('granted'/'denied') -> die gilt weiter, Land spielt keine Rolle.
       *  2. Sonst: Land ueber eine anonyme, oeffentliche Diagnose-Anfrage an
       *     Cloudflare bestimmen (die Seite ist rein statisch ueber GitHub
       *     Pages ausgeliefert, es gibt also keinen eigenen Server, der
       *     Geo-Header wie CF-IPCountry auswerten koennte). USA-Besucher:innen
       *     brauchen keine Einwilligung nach TDDDG/DSGVO -> Clarity laedt fuer
       *     sie direkt, der Cookie-Hinweis erscheint gar nicht erst.
       *  3. Schlaegt die Anfrage fehl, dauert zu lange oder ist das Ergebnis
       *     nicht eindeutig 'US' -> sicherheitshalber wird trotzdem um
       *     Einwilligung gebeten (fail-safe Richtung mehr Datenschutz, nie
       *     umgekehrt). Siehe datenschutz.astro Ziffer 8 fuer die Erklaerung
       *     dieser Anfrage selbst.
       * Ergebnis wird pro Browser-Sitzung zwischengespeichert (sessionStorage),
       * damit nicht jede Unterseite erneut anfragt.
       */
      window.octaConsentReady = new Promise(function (resolve) {
        var KEY = 'octa-consent-analytics';
        var settled = false;
        function settle(result) {
          if (settled) return;
          settled = true;
          resolve(result);
        }

        var decided = null;
        try {
          decided = localStorage.getItem(KEY);
        } catch (e) {}
        if (decided === 'granted') {
          window.octaLoadMarketingTools();
          settle({ showBanner: false });
          return;
        }
        if (decided === 'denied') {
          settle({ showBanner: false });
          return;
        }

        function withCountry(country) {
          if (country === 'US') {
            window.octaLoadMarketingTools();
            settle({ showBanner: false });
          } else {
            settle({ showBanner: true });
          }
        }

        var cached = null;
        try {
          cached = sessionStorage.getItem('octa-geo-country');
        } catch (e) {}
        if (cached) {
          withCountry(cached);
          return;
        }

        // Antwortet die Geo-Anfrage nicht innerhalb von 2,5s (langsames Netz,
        // blockierter Request, ...), sicherheitshalber Banner zeigen statt
        // Besucher:innen ohne Reaktion haengen zu lassen.
        setTimeout(function () {
          settle({ showBanner: true });
        }, 2500);

        fetch('https://www.cloudflare.com/cdn-cgi/trace', { cache: 'no-store' })
          .then(function (r) {
            return r.text();
          })
          .then(function (text) {
            var m = /(?:^|\n)loc=([A-Z]{2})/.exec(text);
            var country = m ? m[1] : '';
            try {
              sessionStorage.setItem('octa-geo-country', country);
            } catch (e) {}
            withCountry(country);
          })
          .catch(function () {
            settle({ showBanner: true });
          });
      });

      /**
       * Kombiniertes Conversion-Signal fuer Meta Ads: "Quiz abgeschlossen,
       * danach auf einen App-Store-Link geklickt". Der erste Teil wird beim
       * Quiz-Abschluss nur als Merker in sessionStorage hinterlegt (siehe
       * lerntyp-test.astro / en/tools/lerntyp-test.astro, Schluessel
       * 'octa-quiz-finished') — ausgeloest wird das eigentliche Event
       * "QuizCompleteAppClick" erst hier, sobald danach irgendwo auf der
       * Seite (nicht nur auf der Quiz-Seite selbst) ein App-Store-Link
       * angeklickt wird. Nur aktiv, wenn das Meta Pixel ueberhaupt geladen
       * ist (also Einwilligung vorliegt oder die US-Ausnahme oben greift) —
       * sonst passiert schlicht nichts. Feuert gleichzeitig clientseitig
       * (Pixel) und serverseitig (Conversions API ueber den Cloudflare
       * Worker) mit derselben Event-ID, damit Meta beide als ein Ereignis
       * erkennt statt es doppelt zu zaehlen.
       */
      function octaCookie(name) {
        var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
        return m ? decodeURIComponent(m[1]) : '';
      }

      document.addEventListener('click', function (ev) {
        if (!window.octaMetaPixelLoaded || typeof fbq !== 'function') return;
        var finished = false;
        try {
          finished = sessionStorage.getItem('octa-quiz-finished') === '1';
        } catch (e) {}
        if (!finished) return;

        var link = ev.target && ev.target.closest && ev.target.closest('a[href*="apps.apple.com"]');
        if (!link) return;

        var eventId =
          window.crypto && window.crypto.randomUUID
            ? window.crypto.randomUUID()
            : 'e-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 12);
        var eventTime = Math.floor(Date.now() / 1000);
        var sourceUrl = location.href;

        fbq('trackCustom', 'QuizCompleteAppClick', {}, { eventID: eventId });

        try {
          fetch('https://octastudy-warteliste.karl-7b5.workers.dev/meta-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event_id: eventId,
              event_time: eventTime,
              event_source_url: sourceUrl,
              fbp: octaCookie('_fbp'),
              fbc: octaCookie('_fbc'),
            }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      });
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{skipLinkLabel}</a>

    <Header lang={lang} />

    <main id="main">
      {
        breadcrumbs.length > 0 && (
          <div class={containerClass}>
            <nav class="breadcrumb" aria-label={breadcrumbLabel}>
              <ol>
                <li>
                  <a href="/">{homeLabel}</a>
                </li>
                {breadcrumbs.map((crumb, i) =>
                  i === breadcrumbs.length - 1 ? (
                    <li aria-current="page">{crumb.label}</li>
                  ) : (
                    <li>
                      <a href={crumb.href}>{crumb.label}</a>
                    </li>
                  )
                )}
              </ol>
            </nav>
          </div>
        )
      }

      <slot />
    </main>

    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
